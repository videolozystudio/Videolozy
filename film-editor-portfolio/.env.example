# =============================================================================
# Environment Variables — Film Editor Portfolio
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Project Settings
# Find these in: Supabase Dashboard > Project > Settings > API
# -----------------------------------------------------------------------------

# Your Supabase project URL (e.g. https://xxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key — safe to expose in frontend JS (protected by RLS policies)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Service role key — SERVER-SIDE ONLY (Vercel functions / API routes)
# This key bypasses RLS. Never expose it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE

# -----------------------------------------------------------------------------
# PostHog — Analytics
# Find these in: PostHog > Project Settings > Project API Key
# -----------------------------------------------------------------------------

# PostHog project API key (safe to expose on frontend)
POSTHOG_KEY=phc_YOUR_POSTHOG_PROJECT_KEY_HERE

# PostHog host (use https://app.posthog.com for cloud, or your self-hosted URL)
POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------

# The public URL of your deployed site (no trailing slash)
SITE_URL=https://your-editor-portfolio.vercel.app

# Display name of the portfolio owner (used in meta tags, footer, etc.)
EDITOR_NAME=Alex Rivera

# Short tagline / headline for the hero section
EDITOR_TAGLINE=Crafting Stories Through the Art of the Edit

# Contact email shown in the footer
CONTACT_EMAIL=hello@your-portfolio.com

# -----------------------------------------------------------------------------
# Social Links (optional — leave blank to hide)
# -----------------------------------------------------------------------------
SOCIAL_VIMEO=https://vimeo.com/yourusername
SOCIAL_INSTAGRAM=https://instagram.com/yourusername
SOCIAL_LINKEDIN=https://linkedin.com/in/yourusername
SOCIAL_TWITTER=https://twitter.com/yourusername

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Upstash Redis — Rate Limiting (api/lib/rateLimiter.js)
# Find these in: Upstash Console > Your Database > REST API
# -----------------------------------------------------------------------------

# The HTTPS REST endpoint for your Upstash Redis database
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io

# The REST auth token for your Upstash Redis database
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN_HERE
