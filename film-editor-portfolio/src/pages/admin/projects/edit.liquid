---
layout: admin
title: Edit Project
admin_page_title: Edit Project
noindex: true
permalink: /admin/projects/edit/
---

<!--
  EDIT PROJECT PAGE
  The project ID is read from the URL query string: ?id=UUID
  JS fetches the project from Supabase and pre-fills the form.
-->

<!-- Breadcrumb -->
<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-2 text-sm text-text-muted">
    <li><a href="/admin/" class="hover:text-white transition-colors">Dashboard</a></li>
    <li aria-hidden="true">›</li>
    <li><a href="/admin/projects/" class="hover:text-white transition-colors">Projects</a></li>
    <li aria-hidden="true">›</li>
    <li id="edit-breadcrumb-title" class="text-text-primary">Edit Project</li>
  </ol>
</nav>

<div class="max-w-3xl">

  <!-- Page Header -->
  <div class="mb-8 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold text-white" id="edit-page-title">Edit Project</h2>
      <p class="text-sm text-text-muted mt-1">
        Update project details. Required fields are marked with
        <span class="text-neon-red">*</span>
      </p>
    </div>
    <!-- Live preview link (filled by JS) -->
    <a
      id="edit-live-preview-btn"
      href="#"
      target="_blank"
      class="btn-ghost text-sm flex-shrink-0 hidden"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
      Preview
    </a>
  </div>

  <!-- Loading skeleton -->
  <div id="edit-loading" class="glass rounded-2xl border border-border p-6 sm:p-8 space-y-6 animate-pulse">
    <div class="grid grid-cols-2 gap-4">
      <div class="space-y-2">
        <div class="skeleton h-4 w-20 rounded"></div>
        <div class="skeleton h-10 w-full rounded-lg"></div>
      </div>
      <div class="space-y-2">
        <div class="skeleton h-4 w-24 rounded"></div>
        <div class="skeleton h-10 w-full rounded-lg"></div>
      </div>
    </div>
    <div class="space-y-2">
      <div class="skeleton h-4 w-24 rounded"></div>
      <div class="skeleton h-28 w-full rounded-lg"></div>
    </div>
    <div class="skeleton h-12 w-40 rounded-lg ml-auto"></div>
  </div>

  <!-- Form Card (shown after data loads) -->
  <div id="edit-form-container" class="glass rounded-2xl border border-border p-6 sm:p-8 hidden">
    {% include "components/admin/project-form.liquid" %}
  </div>

  <!-- Error state -->
  <div id="edit-error" class="hidden glass rounded-2xl border border-danger/30 p-8 text-center">
    <svg class="w-12 h-12 text-danger mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <h3 class="text-lg font-semibold text-white mb-2">Project Not Found</h3>
    <p class="text-text-muted mb-6">This project may have been deleted or the ID is invalid.</p>
    <a href="/admin/projects/" class="btn-neon">Back to Projects</a>
  </div>

</div>
