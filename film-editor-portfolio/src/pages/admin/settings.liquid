---
layout: admin
title: Settings
admin_page_title: Settings
noindex: true
permalink: /admin/settings/
---

<div class="max-w-2xl space-y-6">

  <!-- Account Info -->
  <div class="glass rounded-2xl border border-border p-6 sm:p-8">
    <h2 class="text-lg font-semibold text-white mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-neon-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      Account
    </h2>

    <!-- Current user info (filled by JS) -->
    <div class="flex items-center gap-4 mb-6 p-4 rounded-xl bg-card border border-border">
      <div class="w-12 h-12 rounded-full bg-neon-silver/20 flex items-center justify-center flex-shrink-0">
        <span id="settings-avatar" class="text-neon-silver text-lg font-bold">A</span>
      </div>
      <div>
        <p id="settings-email" class="text-sm font-semibold text-white">Loading…</p>
        <p class="text-xs text-text-muted">Administrator · <span id="settings-last-sign-in">—</span></p>
      </div>
    </div>

    <!-- Change Email -->
    <form id="change-email-form" novalidate class="space-y-4 pb-6 border-b border-border">
      <h3 class="text-sm font-semibold text-text-secondary">Change Email</h3>
      <div>
        <label for="new-email" class="block text-sm text-text-muted mb-1.5">New Email Address</label>
        <input
          type="email"
          id="new-email"
          name="email"
          class="input-field"
          placeholder="new@example.com"
          autocomplete="email"
        />
      </div>
      <button type="submit" class="btn-outline text-sm" id="btn-change-email">
        Update Email
      </button>
    </form>

    <!-- Change Password -->
    <form id="change-password-form" novalidate class="space-y-4 pt-6">
      <h3 class="text-sm font-semibold text-text-secondary">Change Password</h3>
      <div>
        <label for="new-password" class="block text-sm text-text-muted mb-1.5">New Password</label>
        <input
          type="password"
          id="new-password"
          name="password"
          class="input-field"
          placeholder="Minimum 8 characters"
          minlength="8"
          autocomplete="new-password"
        />
      </div>
      <div>
        <label for="confirm-password" class="block text-sm text-text-muted mb-1.5">Confirm Password</label>
        <input
          type="password"
          id="confirm-password"
          name="confirm_password"
          class="input-field"
          placeholder="Repeat new password"
          autocomplete="new-password"
        />
        <p class="form-error hidden text-danger text-xs mt-1" id="password-match-error">
          Passwords do not match.
        </p>
      </div>
      <button type="submit" class="btn-outline text-sm" id="btn-change-password">
        Update Password
      </button>
    </form>
  </div>

  <!-- Danger Zone -->
  <div class="glass rounded-2xl border border-danger/20 p-6 sm:p-8">
    <h2 class="text-lg font-semibold text-danger mb-4 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Danger Zone
    </h2>
    <p class="text-sm text-text-muted mb-4">
      These actions are irreversible. Proceed with caution.
    </p>
    <button
      id="btn-sign-out-all"
      class="btn-ghost text-sm border border-danger/30 text-danger hover:bg-danger/10"
    >
      Sign Out All Devices
    </button>
  </div>

</div>
