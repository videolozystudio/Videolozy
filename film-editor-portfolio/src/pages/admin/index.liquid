<!-- ============================================================
     STATS CARDS
     ============================================================ -->
{% include "components/admin/dashboard-stats.liquid" %}

<!-- ============================================================
     RECENT PROJECTS + QUICK ACTIONS
     ============================================================ -->
<div class="mt-8 grid grid-cols-1 xl:grid-cols-3 gap-6">

  <!-- Recent Projects (takes 2/3 width) -->
  <div class="xl:col-span-2">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-base font-semibold text-text-primary">Recent Projects</h2>
      <a href="/admin/projects/" class="text-sm text-neon-silver hover:text-neon-silver-600 transition-colors">
        View all →
      </a>
    </div>

    <div class="glass rounded-xl border border-border overflow-hidden">
      <div id="recent-projects-list" class="divide-y divide-border">
        <!-- Skeleton rows loaded by JS -->
        <div class="flex items-center gap-4 p-4 animate-pulse">
          <div class="skeleton h-12 w-20 rounded-lg flex-shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-4 w-48 rounded"></div>
            <div class="skeleton h-3 w-28 rounded"></div>
          </div>
          <div class="skeleton h-6 w-16 rounded-full hidden sm:block"></div>
          <div class="skeleton h-8 w-14 rounded"></div>
        </div>
        <div class="flex items-center gap-4 p-4 animate-pulse">
          <div class="skeleton h-12 w-20 rounded-lg flex-shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-4 w-48 rounded"></div>
            <div class="skeleton h-3 w-28 rounded"></div>
          </div>
          <div class="skeleton h-6 w-16 rounded-full hidden sm:block"></div>
          <div class="skeleton h-8 w-14 rounded"></div>
        </div>
        <div class="flex items-center gap-4 p-4 animate-pulse">
          <div class="skeleton h-12 w-20 rounded-lg flex-shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-4 w-48 rounded"></div>
            <div class="skeleton h-3 w-28 rounded"></div>
          </div>
          <div class="skeleton h-6 w-16 rounded-full hidden sm:block"></div>
          <div class="skeleton h-8 w-14 rounded"></div>
        </div>
      </div>

      <!-- Empty state (shown by JS if no projects) -->
      <div id="recent-projects-empty" class="hidden py-12 text-center">
        <p class="text-sm text-text-muted">No projects yet. Add your first one!</p>
        <a href="/admin/projects/new/" class="btn-neon text-sm mt-4 inline-flex">
          Add Project
        </a>
      </div>
    </div>
  </div>

  <!-- Quick Actions Sidebar (1/3 width) -->
  <div>
    <h2 class="text-base font-semibold text-text-primary mb-4">Quick Actions</h2>
    <div class="space-y-3">

      <a
        href="/admin/projects/new/"
        class="flex items-center gap-3 p-4 rounded-xl glass border border-border
               hover:border-neon-silver/30 transition-all duration-200 group"
        id="qa-add-project"
      >
        <div class="w-9 h-9 rounded-lg bg-neon-silver/15 border border-neon-silver/20 flex items-center justify-center
                    group-hover:bg-neon-silver/25 transition-colors">
          <svg class="w-4 h-4 text-neon-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-text-primary">Add Project</p>
          <p class="text-2xs text-text-muted">Create a new portfolio entry</p>
        </div>
      </a>

      <a
        href="/admin/projects/"
        class="flex items-center gap-3 p-4 rounded-xl glass border border-border
               hover:border-border-hover transition-all duration-200 group"
        id="qa-manage-projects"
      >
        <div class="w-9 h-9 rounded-lg bg-card border border-border flex items-center justify-center
                    group-hover:border-border-hover transition-colors">
          <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-text-primary">Manage Projects</p>
          <p class="text-2xs text-text-muted">Edit or delete existing work</p>
        </div>
      </a>

      <a
        href="/"
        target="_blank"
        class="flex items-center gap-3 p-4 rounded-xl glass border border-border
               hover:border-border-hover transition-all duration-200 group"
        id="qa-view-site"
      >
        <div class="w-9 h-9 rounded-lg bg-card border border-border flex items-center justify-center
                    group-hover:border-border-hover transition-colors">
          <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-text-primary">View Live Site</p>
          <p class="text-2xs text-text-muted">Opens portfolio in new tab</p>
        </div>
      </a>

      <!-- Refresh Analytics -->
      <button
        id="btn-refresh-analytics"
        class="flex items-center gap-3 p-4 rounded-xl glass border border-border
               hover:border-border-hover transition-all duration-200 group w-full text-left"
      >
        <div class="w-9 h-9 rounded-lg bg-card border border-border flex items-center justify-center
                    group-hover:border-border-hover transition-colors">
          <svg class="w-4 h-4 text-text-secondary" id="refresh-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-text-primary">Refresh Analytics</p>
          <p class="text-2xs text-text-muted">Update materialized view</p>
        </div>
      </button>

    </div>

    <!-- System Info Card -->
    <div class="mt-4 p-4 rounded-xl glass border border-border">
      <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">System</h3>
      <div class="space-y-2">
        <div class="flex justify-between text-xs">
          <span class="text-text-muted">Database</span>
          <span class="text-green-400 font-medium flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
            Supabase
          </span>
        </div>
        <div class="flex justify-between text-xs">
          <span class="text-text-muted">Hosting</span>
          <span class="text-text-secondary font-medium">Vercel</span>
        </div>
        <div class="flex justify-between text-xs">
          <span class="text-text-muted">SSG</span>
          <span class="text-text-secondary font-medium">Eleventy v3</span>
        </div>
      </div>
    </div>
  </div>

</div>
