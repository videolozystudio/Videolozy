            <div>
              <p class="text-2xs text-text-muted uppercase tracking-wider font-semibold mb-1">Year</p>
              <p id="project-year" class="text-sm text-text-primary font-medium">—</p>
            </div>
            <div>
              <p class="text-2xs text-text-muted uppercase tracking-wider font-semibold mb-1">Category</p>
              <p id="project-category-text" class="text-sm text-text-primary font-medium">—</p>
            </div>
            <div>
              <p class="text-2xs text-text-muted uppercase tracking-wider font-semibold mb-1">Platform</p>
              <p id="project-platform" class="text-sm text-text-primary font-medium">—</p>
            </div>
            <div class="pt-4 border-t border-border">
              <a href="/#work" class="btn-ghost text-sm w-full justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to Portfolio
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- PREV / NEXT NAVIGATION -->
