        </div>

        <!-- Sidebar Meta -->
        <div class="lg:col-span-1">
          <div class="glass rounded-xl border border-border p-6 space-y-5">
            <div>
              <p class="text-2xs text-text-muted uppercase tracking-wider font-semibold mb-1">Client</p>
              <p id="project-client" class="text-sm text-text-primary font-medium">—</p>
