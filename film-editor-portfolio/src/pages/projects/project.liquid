<!--
  PROJECT DETAIL PAGE — Static Shell
  Project data is fetched entirely client-side from Supabase by client.js.
  The project ID is passed via URL query string: /projects/detail/?id=UUID
-->

<!-- Extract project ID from URL for JS -->
<div
  id="project-page"
  class="min-h-screen"
>

  <!-- ============================================================
       Loading State
       ============================================================ -->
  <div id="project-loading" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb skeleton -->
      <div class="flex items-center gap-2 mb-8">
        <div class="skeleton h-4 w-12 rounded"></div>
        <div class="skeleton h-4 w-4 rounded"></div>
        <div class="skeleton h-4 w-32 rounded"></div>
      </div>
      <!-- Player skeleton -->
      <div class="w-full rounded-xl mb-8 skeleton" style="padding-bottom:56.25%; position:relative;">
        <div class="absolute inset-0 flex items-center justify-center">
          <svg class="w-12 h-12 text-text-muted/20 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
          </svg>
        </div>
      </div>
      <!-- Meta skeleton -->
      <div class="space-y-3 max-w-2xl">
        <div class="skeleton h-8 w-3/4 rounded"></div>
        <div class="skeleton h-5 w-1/2 rounded"></div>
        <div class="skeleton h-4 w-full rounded mt-4"></div>
        <div class="skeleton h-4 w-5/6 rounded"></div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       Project Content (revealed by JS after data loads)
       ============================================================ -->
  <div id="project-content" class="hidden">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-4">
      <ol class="flex items-center gap-2 text-sm text-text-muted">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li aria-hidden="true">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </li>
        <li><a href="/#work" class="hover:text-white transition-colors">Work</a></li>
        <li aria-hidden="true">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </li>
        <li class="text-text-primary font-medium truncate max-w-xs" id="breadcrumb-title">Project</li>
      </ol>
    </nav>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">

      <!-- VIDEO PLAYER CONTAINER (injected by JS) -->
      <div class="mb-10" id="project-player-container"></div>

      <!-- PROJECT METADATA -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16">

        <!-- Main Info -->
        <div class="lg:col-span-2">
          <div class="flex items-center gap-2 mb-4">
            <span id="project-category-badge" class="badge bg-neon-red/15 border border-neon-red/30 text-neon-red"></span>
            <span id="project-featured-badge" class="badge bg-yellow-500/15 border border-yellow-500/30 text-yellow-400 hidden">★ Featured</span>
          </div>

          <h1 id="project-title" class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight mb-4"></h1>

          <div id="project-description" class="text-text-secondary leading-relaxed space-y-3 mb-8"></div>

          <div class="flex items-center gap-2 text-sm text-text-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
            <span id="project-view-count" class="font-semibold text-white">—</span> views
