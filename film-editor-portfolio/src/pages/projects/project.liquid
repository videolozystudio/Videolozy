        <a id="nav-prev" href="#" class="group flex items-center gap-3 p-4 rounded-xl bg-card border border-border hover:border-border-hover transition-all duration-200">
          <svg class="w-5 h-5 text-text-muted group-hover:text-neon-red transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          <div class="min-w-0">
            <p class="text-2xs text-text-muted uppercase tracking-wider mb-0.5">Previous</p>
            <p id="nav-prev-title" class="text-sm font-medium text-text-primary truncate"></p>
          </div>
        </a>
        <a id="nav-next" href="#" class="group flex items-center justify-end gap-3 p-4 rounded-xl bg-card border border-border hover:border-border-hover transition-all duration-200 text-right">
          <div class="min-w-0">
            <p class="text-2xs text-text-muted uppercase tracking-wider mb-0.5">Next</p>
            <p id="nav-next-title" class="text-sm font-medium text-text-primary truncate"></p>
          </div>
          <svg class="w-5 h-5 text-text-muted group-hover:text-neon-red transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

  <!-- ERROR STATE -->
  <div id="project-error" class="hidden py-32 text-center">
    <div class="max-w-sm mx-auto px-4">
      <p class="text-6xl font-black text-neon-red mb-4">404</p>
      <h1 class="text-2xl font-bold text-white mb-3">Project Not Found</h1>
      <p class="text-text-muted mb-8">This project may have been removed or the URL has changed.</p>
      <a href="/#work" class="btn-neon">Back to Portfolio</a>
    </div>
  </div>

</div>
