---
layout: client
title: Film Editor Portfolio
description: Award-winning film editor specializing in commercials, short films, music videos, and documentaries.
permalink: /
---

<!-- ============================================================
     HERO SECTION — Black, White, Neon Red & Neon Yellow Parallax
     ============================================================ -->
<section
  class="relative min-h-[92vh] flex items-center justify-center overflow-hidden py-16 sm:py-24"
  aria-labelledby="hero-headline"
  id="hero"
>
  <!-- Background Layers -->
  <div class="absolute inset-0 bg-void"></div>

  <!-- Multi-Layered Floating Parallax Ambient Orbs -->
  <!-- Orb 1: Neon Yellow Orb Top Left -->
  <div
    class="absolute top-10 left-1/6 w-[28rem] h-[28rem] rounded-full opacity-25 pointer-events-none animate-parallax-float blur-3xl"
    style="background: radial-gradient(circle, rgba(255,230,0,0.4) 0%, rgba(255,230,0,0.05) 55%, transparent 75%);"
    aria-hidden="true"
  ></div>

  <!-- Orb 2: Neon Red Orb Bottom Right -->
  <div
    class="absolute bottom-12 right-1/6 w-[32rem] h-[32rem] rounded-full opacity-25 pointer-events-none animate-parallax-reverse blur-3xl"
    style="background: radial-gradient(circle, rgba(255,0,64,0.35) 0%, rgba(255,0,64,0.08) 55%, transparent 75%);"
    aria-hidden="true"
  ></div>

  <!-- Orb 3: Pure Crisp White Beam Top Right -->
  <div
    class="absolute top-1/3 right-1/4 w-80 h-80 rounded-full opacity-15 pointer-events-none animate-parallax-drift blur-2xl"
    style="background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Grid overlay with subtle white grid lines -->
  <div
    class="absolute inset-0 opacity-15 pointer-events-none animate-parallax-drift"
    aria-hidden="true"
    style="background-image: linear-gradient(rgba(255,255,255,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.14) 1px, transparent 1px); background-size: 60px 60px;"
  ></div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">



    <!-- Main Headline -->
    <h1
      id="hero-headline"
      class="text-4xl sm:text-6xl lg:text-7xl font-black leading-[1.05] tracking-tight mb-6
             animate-fade-in"
      style="animation-delay: 0.1s; opacity: 0; animation-fill-mode: forwards;"
    >
      Crafting Visuals with
      <br />
      <span class="bg-gradient-to-r from-white via-neon-yellow to-neon-silver bg-clip-text text-transparent drop-shadow-lg">
        Rhythm & Pacing.
      </span>
    </h1>

    <!-- Tagline -->
    <p
      class="max-w-2xl mx-auto text-lg sm:text-xl text-gray-300 font-normal leading-relaxed mb-10
             animate-fade-in"
      style="animation-delay: 0.25s; opacity: 0; animation-fill-mode: forwards;"
    >
      {{ site.tagline }} — Led by founder <strong class="text-white">Bhuvan Bhaskar</strong>. Transforming raw footage into cinematic experiences with sound precision, color depth, and narrative impact.
    </p>

    <!-- CTA Buttons -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-5
             animate-fade-in"
      style="animation-delay: 0.4s; opacity: 0; animation-fill-mode: forwards;"
    >
      <a href="#work" class="btn-yellow text-base px-8 py-3.5 w-full sm:w-auto" id="hero-cta-work">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Explore Portfolio Reel
      </a>
      <a href="#" class="btn-neon text-base px-8 py-3.5 w-full sm:w-auto" data-trigger="project-modal">
        Start a Project
      </a>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2
           animate-float opacity-70"
    aria-hidden="true"
  >
    <span class="text-2xs text-neon-yellow font-bold tracking-widest uppercase">Scroll Down</span>
    <div class="w-px h-8 bg-gradient-to-b from-neon-yellow to-transparent"></div>
  </div>
</section>


<!-- ============================================================
     DESIGN SHOWCASE SECTION — Animated 3D card portfolio wall
     ============================================================ -->
{% assign ds_hl1     = "A Design Partner" %}
{% assign ds_hl2     = "You Can Trust." %}
{% assign ds_anim_dur = "22s" %}
{% assign ds_tagline  = "Post-Production Studio · Bhuvan Bhaskar" %}
{% include "components/design-showcase.liquid" %}

<!-- ============================================================
     STATS SECTION — Crisp White Glass Panels with Neon Accents
     ============================================================ -->
<section class="py-16 border-y border-white/10 bg-surface/80 relative" aria-label="Career statistics">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">

      <div class="stat-counter p-6 rounded-2xl white-glass-card text-center group hover:border-neon-yellow/50 transition-all duration-300" data-target="120" data-suffix="+">
        <p class="text-4xl sm:text-5xl font-black text-neon-yellow mb-1 drop-shadow-md">
          <span class="counter-value">0</span><span class="text-white">+</span>
        </p>
        <p class="text-xs sm:text-sm text-gray-300 font-semibold tracking-wide uppercase">Projects Completed</p>
      </div>

      <div class="stat-counter p-6 rounded-2xl white-glass-card text-center group hover:border-neon-silver/50 transition-all duration-300" data-target="{{ site.yearsActive }}" data-suffix="+">
        <p class="text-4xl sm:text-5xl font-black text-neon-silver mb-1 drop-shadow-md">
          <span class="counter-value">0</span><span class="text-white">+</span>
        </p>
        <p class="text-xs sm:text-sm text-gray-300 font-semibold tracking-wide uppercase">Years Experience</p>
      </div>

      <div class="stat-counter p-6 rounded-2xl white-glass-card text-center group hover:border-neon-yellow/50 transition-all duration-300" data-target="50" data-suffix="+">
        <p class="text-4xl sm:text-5xl font-black text-neon-yellow mb-1 drop-shadow-md">
          <span class="counter-value">0</span><span class="text-white">+</span>
        </p>
        <p class="text-xs sm:text-sm text-gray-300 font-semibold tracking-wide uppercase">Brands & Studios</p>
      </div>

      <div class="stat-counter p-6 rounded-2xl white-glass-card text-center group hover:border-neon-silver/50 transition-all duration-300" data-target="8" data-suffix="">
        <p class="text-4xl sm:text-5xl font-black text-neon-silver mb-1 drop-shadow-md">
          <span class="counter-value">0</span>
          <span class="text-white">×</span>
        </p>
        <p class="text-xs sm:text-sm text-gray-300 font-semibold tracking-wide uppercase">Award-Winning Edits</p>
      </div>

    </div>
  </div>
</section>

<!-- ============================================================
     WORK / VIDEO GRID SECTION
     ============================================================ -->
<section
  class="py-20 lg:py-28 relative"
  id="work"
  aria-labelledby="work-heading"
>
  <!-- Background Glow -->
  <div class="absolute top-1/2 left-10 w-96 h-96 rounded-full opacity-15 bg-neon-yellow blur-3xl pointer-events-none animate-parallax-float"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="mb-12 lg:mb-16">
      <span class="yellow-pill-badge px-3.5 py-1 text-2xs font-bold uppercase tracking-widest mb-3 inline-block">
        ⚡ PORTFOLIO & REELS
      </span>
      <h2
        id="work-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight"
      >
        Selected Work
      </h2>
      <p class="mt-4 text-gray-300 max-w-xl text-base">
        Explore a curated showcase of commercial campaigns, short narrative films, music videos, and feature documentaries.
      </p>
    </div>

    <!-- Projects Grid Component -->
    {% include "components/video-grid.liquid" %}

  </div>
</section>

<!-- ============================================================
     ABOUT SECTION
     ============================================================ -->
<section
  class="py-20 lg:py-28 border-t border-white/10 relative overflow-hidden bg-surface/40"
  id="about"
  aria-labelledby="about-heading"
>
  <!-- Parallax Floating Orbs -->
  <div class="absolute -top-12 -right-12 w-96 h-96 rounded-full opacity-20 bg-neon-yellow blur-3xl animate-parallax-float pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Text Side -->
      <div>
        <span class="yellow-pill-badge px-3.5 py-1 text-2xs font-bold uppercase tracking-widest mb-4 inline-block">
          ★ ABOUT VIDEOLOZY
        </span>
        <h2
          id="about-heading"
          class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6"
        >
          The Studio Behind
          <br />the <span class="bg-gradient-to-r from-neon-yellow to-neon-silver bg-clip-text text-transparent">Master Cut.</span>
        </h2>
        <div class="space-y-4 text-gray-300 leading-relaxed text-base">
          <p>
            Led by founder and lead editor <strong class="text-white">Bhuvan Bhaskar</strong>, <strong class="text-neon-yellow">Videolozy.in</strong> is a premier full-service post-production studio dedicated to high-impact visual storytelling.
          </p>
          <p>
            We specialize in rhythm-driven editing, precision color grading, dynamic motion graphics, and immersive sound design. Every project is crafted to connect emotionally with audiences across screens worldwide.
          </p>
        </div>

        <!-- Skills Tags -->
        <div class="mt-8 flex flex-wrap gap-2.5">
          {% assign skills = "Adobe Premiere Pro,DaVinci Resolve Studio,After Effects,Color Grading,Sound Design,Motion Graphics,Commercial Editing,Documentary" | split: "," %}
          {% for skill in skills %}
          <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold yellow-pill-badge transition-colors hover:bg-neon-yellow hover:text-black">
            {{ skill }}
          </span>
          {% endfor %}
        </div>

      </div>

      <!-- Visual Side — Parallax Glass Cards -->
      <div class="relative">
        <div class="relative w-full max-w-sm mx-auto lg:ml-auto">
          <!-- Background card -->
          <div class="absolute inset-0 transform translate-x-5 translate-y-5 rounded-2xl
                      bg-neon-yellow/[0.08] border border-neon-yellow/30 backdrop-blur-md animate-parallax-reverse"></div>
          <!-- Middle card -->
          <div class="absolute inset-0 transform translate-x-2.5 translate-y-2.5 rounded-2xl
                      bg-neon-silver/[0.08] border border-neon-silver/30 backdrop-blur-md"></div>
          <!-- Front card -->
          <div class="relative rounded-2xl white-glass-card p-8 shadow-2xl animate-parallax-float">
            <!-- Decorative film strip -->
            <div class="flex justify-center mb-6">
              <div class="flex gap-1.5 p-1.5 rounded-lg bg-black/60 border border-white/20">
                <div class="w-3 h-5 rounded-sm bg-neon-yellow"></div>
                <div class="w-3 h-5 rounded-sm bg-white/40"></div>
                <div class="w-3 h-5 rounded-sm bg-neon-silver"></div>
                <div class="w-3 h-5 rounded-sm bg-white/40"></div>
                <div class="w-3 h-5 rounded-sm bg-neon-yellow"></div>
                <div class="w-3 h-5 rounded-sm bg-white/40"></div>
                <div class="w-3 h-5 rounded-sm bg-neon-silver"></div>
              </div>
            </div>
            <!-- Stats grid -->
            <div class="grid grid-cols-2 gap-4 text-center">
              <div class="p-4 rounded-xl bg-black/60 border border-white/15 hover:border-neon-yellow/40 transition-colors">
                <p class="text-2xl font-black text-neon-yellow">120+</p>
                <p class="text-2xs text-gray-300 mt-0.5 uppercase tracking-wider font-bold">Projects</p>
              </div>
              <div class="p-4 rounded-xl bg-black/60 border border-white/15 hover:border-neon-silver/40 transition-colors">
                <p class="text-2xl font-black text-neon-silver">{{ site.yearsActive }}+</p>
                <p class="text-2xs text-gray-300 mt-0.5 uppercase tracking-wider font-bold">Years</p>
              </div>
              <div class="p-4 rounded-xl bg-black/60 border border-white/15 hover:border-neon-silver/40 transition-colors">
                <p class="text-2xl font-black text-white">8×</p>
                <p class="text-2xs text-gray-300 mt-0.5 uppercase tracking-wider font-bold">Awards</p>
              </div>
              <div class="p-4 rounded-xl bg-black/60 border border-white/15 hover:border-neon-yellow/40 transition-colors">
                <p class="text-2xl font-black text-neon-yellow">50+</p>
                <p class="text-2xs text-gray-300 mt-0.5 uppercase tracking-wider font-bold">Clients</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% include "components/project-modal.liquid" %}
