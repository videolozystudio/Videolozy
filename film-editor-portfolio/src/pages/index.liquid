---
layout: client
title: Film Editor Portfolio
description: Award-winning film editor specializing in commercials, short films, music videos, and documentaries.
permalink: /
---

<!-- ============================================================
     HERO SECTION
     ============================================================ -->
<section
  class="relative min-h-[90vh] flex items-center justify-center overflow-hidden"
  aria-labelledby="hero-headline"
  id="hero"
>
  <!-- Animated background noise / grain effect -->
  <div class="absolute inset-0 bg-gradient-dark"></div>

  <!-- Parallax Floating White Radial Glow Orbs & Light Beams -->
  <div
    class="absolute top-1/4 left-10 w-96 h-96 rounded-full opacity-15 pointer-events-none animate-parallax-float animate-white-pulse"
    style="background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.05) 50%, transparent 80%);"
    aria-hidden="true"
  ></div>
  <div
    class="absolute bottom-1/4 right-12 w-[30rem] h-[30rem] rounded-full opacity-10 pointer-events-none animate-parallax-reverse animate-white-pulse"
    style="background: radial-gradient(circle, rgba(255,255,255,0.25) 0%, rgba(255,0,64,0.08) 50%, transparent 80%);"
    aria-hidden="true"
  ></div>

  <!-- Neon & White Radial Glow Layer -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 65% 55% at 50% 35%, rgba(255,255,255,0.04) 0%, rgba(255,0,64,0.07) 50%, transparent 80%);"
  ></div>

  <!-- Grid overlay with subtle white grid lines -->
  <div
    class="absolute inset-0 opacity-10 pointer-events-none animate-parallax-drift"
    aria-hidden="true"
    style="background-image: linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px); background-size: 70px 70px;"
  ></div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <!-- Pre-headline chip -->
    <div
      class="inline-flex items-center gap-2 mb-6 px-3 py-1.5 rounded-full
             bg-neon-red/10 border border-neon-red/20 text-neon-red text-xs font-semibold
             tracking-wider uppercase animate-fade-in"
      aria-label="Status: Available for work"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-neon-red animate-pulse"></span>
      Available for Projects
    </div>

    <!-- Main Headline -->
    <h1
      id="hero-headline"
      class="text-4xl sm:text-6xl lg:text-7xl font-black leading-[1.05] tracking-tight mb-6
             animate-fade-in"
      style="animation-delay: 0.1s; opacity: 0; animation-fill-mode: forwards;"
    >
      Every Frame
      <br />
      <span class="neon-text">Tells a Story.</span>
    </h1>

    <!-- Tagline -->
    <p
      class="max-w-2xl mx-auto text-lg sm:text-xl text-text-secondary leading-relaxed mb-10
             animate-fade-in"
      style="animation-delay: 0.25s; opacity: 0; animation-fill-mode: forwards;"
    >
      {{ site.tagline }}
    </p>

    <!-- CTA Buttons -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4
             animate-fade-in"
      style="animation-delay: 0.4s; opacity: 0; animation-fill-mode: forwards;"
    >
      <a href="#work" class="btn-neon text-base px-7 py-3 w-full sm:w-auto" id="hero-cta-work">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        View My Work
      </a>
      <a href="mailto:{{ site.email }}" class="btn-outline text-base px-7 py-3 w-full sm:w-auto">
        Get In Touch
      </a>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2
           animate-float opacity-60"
    aria-hidden="true"
  >
    <span class="text-2xs text-text-muted font-medium tracking-widest uppercase">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-text-muted to-transparent"></div>
  </div>
</section>

<!-- ============================================================
     FEATURED SHOWCASE REEL (DEMO VIDEO PLAYER)
     ============================================================ -->
<section class="relative z-20 -mt-10 sm:-mt-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8" id="showcase-reel">
  <div class="rounded-2xl overflow-hidden white-glass-card p-2 sm:p-4 shadow-2xl border border-white/20 relative group">
    <!-- Ambient glow around player -->
    <div class="absolute -inset-1 bg-gradient-to-r from-neon-red/30 via-white/20 to-neon-red/30 rounded-2xl blur-xl opacity-50 group-hover:opacity-100 transition duration-1000 group-hover:duration-200 animate-parallax-float pointer-events-none"></div>

    <div class="relative w-full rounded-xl overflow-hidden bg-black shadow-2xl" style="padding-bottom:56.25%;">
      <div
        class="absolute inset-0 flex items-center justify-center cursor-pointer group/poster"
        data-video-poster
        data-embed-src="https://www.youtube-nocookie.com/embed/RLETBH5_NpY?rel=0&modestbranding=1&autoplay=1"
      >
        <img
          src="https://img.youtube.com/vi/RLETBH5_NpY/maxresdefault.jpg"
          alt="Videolozy.in Showcase Video Reel"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover/poster:scale-105"
          loading="eager"
          onerror="this.src='/assets/images/placeholder-thumb.svg'"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/40 group-hover/poster:bg-black/30 transition-colors duration-300"></div>

        <!-- Video Badge Overlay -->
        <div class="absolute top-4 left-4 sm:top-6 sm:left-6 flex items-center gap-2">
          <span class="badge bg-neon-red text-white text-xs px-3 py-1 font-bold shadow-neon tracking-wide">★ FEATURED SHOWCASE REEL</span>
          <span class="badge bg-black/60 text-white border border-white/20 text-xs px-3 py-1 backdrop-blur-md">Videolozy.in</span>
        </div>

        <!-- Central Play Button -->
        <button
          class="relative z-10 w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-neon-red/90 text-white flex items-center justify-center shadow-neon transform transition-all duration-300 group-hover/poster:scale-110 group-hover/poster:bg-neon-red group-hover/poster:shadow-neon-lg"
          aria-label="Play Videolozy Showcase Reel"
          data-play-btn
        >
          <svg class="w-10 h-10 text-white ml-1.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </button>

        <!-- Bottom Title Overlay -->
        <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6 right-4 sm:right-6 text-left">
          <h3 class="text-lg sm:text-2xl font-bold text-white tracking-tight drop-shadow-md">Videolozy.in — Official Editing & Post-Production Reel</h3>
          <p class="text-xs sm:text-sm text-gray-300 line-clamp-1 mt-1 drop-shadow">Rhythm-Driven Editing • Color Grading • Motion Graphics • Sound Design</p>
        </div>
      </div>
      <iframe
        class="absolute inset-0 w-full h-full hidden"
        title="Videolozy.in Showcase Video Reel"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        style="opacity:0; transition:opacity 0.5s;"
      ></iframe>
    </div>
  </div>
</section>


<!-- ============================================================
     STATS SECTION
     ============================================================ -->
<section class="py-16 border-y border-border bg-surface/50" aria-label="Career statistics">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-4">

      <div class="text-center stat-counter" data-target="120" data-suffix="+">
        <p class="text-4xl sm:text-5xl font-black text-white mb-1">
          <span class="counter-value">0</span><span class="text-neon-red">+</span>
        </p>
        <p class="text-sm text-text-muted font-medium">Projects Completed</p>
      </div>

      <div class="text-center stat-counter" data-target="{{ site.yearsActive }}" data-suffix="+">
        <p class="text-4xl sm:text-5xl font-black text-white mb-1">
          <span class="counter-value">0</span><span class="text-neon-red">+</span>
        </p>
        <p class="text-sm text-text-muted font-medium">Years Experience</p>
      </div>

      <div class="text-center stat-counter" data-target="50" data-suffix="+">
        <p class="text-4xl sm:text-5xl font-black text-white mb-1">
          <span class="counter-value">0</span><span class="text-neon-red">+</span>
        </p>
        <p class="text-sm text-text-muted font-medium">Brands & Studios</p>
      </div>

      <div class="text-center stat-counter" data-target="8" data-suffix="">
        <p class="text-4xl sm:text-5xl font-black text-white mb-1">
          <span class="counter-value">0</span>
          <span class="text-neon-red">×</span>
        </p>
        <p class="text-sm text-text-muted font-medium">Award-Winning Work</p>
      </div>

    </div>
  </div>
</section>

<!-- ============================================================
     WORK / VIDEO GRID SECTION
     ============================================================ -->
<section
  class="py-20 lg:py-28"
  id="work"
  aria-labelledby="work-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="mb-12 lg:mb-16">
      <p class="text-neon-red text-xs font-semibold tracking-widest uppercase mb-3">Portfolio</p>
      <h2
        id="work-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight"
      >
        Selected Work
      </h2>
      <p class="mt-4 text-text-secondary max-w-xl">
        A curated selection of projects spanning commercials, narrative, music, and documentary.
      </p>
    </div>

    <!-- Projects are fetched & rendered client-side from Supabase -->
    <!-- The grid component below provides the filter UI + empty skeleton -->
    {% include "components/video-grid.liquid" %}

  </div>
</section>

<!-- ============================================================
     ABOUT SECTION
     ============================================================ -->
<section
  class="py-20 lg:py-28 border-t border-border"
  id="about"
  aria-labelledby="about-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Text Side -->
      <div>
        <p class="text-neon-red text-xs font-semibold tracking-widest uppercase mb-3">About</p>
        <h2
          id="about-heading"
          class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6"
        >
          The Editor Behind
          <br />the <span class="neon-text">Cut.</span>
        </h2>
        <div class="space-y-4 text-text-secondary leading-relaxed">
          <p>
            Led by founder and lead editor <strong>Bhuvan Bhaskar</strong>, <strong>Videolozy.in</strong> is a full-time video post-production organization dedicated to high-impact visual storytelling. With over {{ site.yearsActive }} years in the edit suite, our team brings relentless precision to every frame.
          </p>
          <p>
            We specialize in rhythm-driven editing, color grading, and motion design — finding the precise moment where sound, motion, and emotion converge. Our arsenal includes Adobe Premiere Pro, DaVinci Resolve Studio, and After Effects.
          </p>
          <p>
            Whether you are a commercial brand, agency director, or filmmaker, Videolozy.in delivers complete post-production solutions with uncompromising quality.
          </p>
        </div>

        <!-- Skills Tags -->
        <div class="mt-8 flex flex-wrap gap-2">
          {% assign skills = "Adobe Premiere Pro,DaVinci Resolve,After Effects,Color Grading,Sound Design,Motion Graphics,Commercial Editing,Documentary" | split: "," %}
          {% for skill in skills %}
          <span class="px-3 py-1.5 rounded-full text-xs font-medium bg-card border border-border
                       text-text-secondary hover:border-neon-red/40 hover:text-white transition-colors">
            {{ skill }}
          </span>
          {% endfor %}
        </div>

        <div class="mt-10">
          <a href="mailto:{{ site.email }}" class="btn-neon text-sm" id="about-cta">
            Start a Conversation
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Visual Side — Decorative with Parallax White Glass Cards -->
      <div class="relative">
        <!-- Floating Ambient White Backing Glow -->
        <div class="absolute -top-10 -right-10 w-72 h-72 rounded-full opacity-20 bg-white blur-3xl animate-parallax-float pointer-events-none"></div>

        <!-- Stacked cards visual -->
        <div class="relative w-full max-w-sm mx-auto lg:ml-auto">
          <!-- Background card -->
          <div class="absolute inset-0 transform translate-x-4 translate-y-4 rounded-2xl
                      bg-white/[0.02] border border-white/10 backdrop-blur-md animate-parallax-reverse"></div>
          <!-- Middle card -->
          <div class="absolute inset-0 transform translate-x-2 translate-y-2 rounded-2xl
                      bg-white/[0.04] border border-white/15 backdrop-blur-md"></div>
          <!-- Front card -->
          <div class="relative rounded-2xl white-glass-card p-8 shadow-2xl animate-parallax-float">
            <!-- Decorative film strip -->
            <div class="flex justify-center mb-6">
              <div class="flex gap-1.5 p-1.5 rounded-lg bg-black/40 border border-white/10">
                <div class="w-3 h-5 rounded-sm bg-neon-red"></div>
                <div class="w-3 h-5 rounded-sm bg-white/20"></div>
                <div class="w-3 h-5 rounded-sm bg-white/60"></div>
                <div class="w-3 h-5 rounded-sm bg-white/20"></div>
                <div class="w-3 h-5 rounded-sm bg-neon-red"></div>
                <div class="w-3 h-5 rounded-sm bg-white/20"></div>
                <div class="w-3 h-5 rounded-sm bg-white/60"></div>
                <div class="w-3 h-5 rounded-sm bg-white/20"></div>
              </div>
            </div>
            <!-- Stats grid -->
            <div class="grid grid-cols-2 gap-4 text-center">
              <div class="p-4 rounded-xl bg-black/50 border border-white/10 hover:border-white/30 transition-colors">
                <p class="text-2xl font-bold text-neon-red">120+</p>
                <p class="text-2xs text-text-muted mt-0.5 uppercase tracking-wider font-semibold">Projects</p>
              </div>
              <div class="p-4 rounded-xl bg-black/50 border border-white/10 hover:border-white/30 transition-colors">
                <p class="text-2xl font-bold text-white">{{ site.yearsActive }}+</p>
                <p class="text-2xs text-text-muted mt-0.5 uppercase tracking-wider font-semibold">Years</p>
              </div>
              <div class="p-4 rounded-xl bg-black/50 border border-white/10 hover:border-white/30 transition-colors">
                <p class="text-2xl font-bold text-white">8×</p>
                <p class="text-2xs text-text-muted mt-0.5 uppercase tracking-wider font-semibold">Awards</p>
              </div>
              <div class="p-4 rounded-xl bg-black/50 border border-white/10 hover:border-white/30 transition-colors">
                <p class="text-2xl font-bold text-white">50+</p>
                <p class="text-2xs text-text-muted mt-0.5 uppercase tracking-wider font-semibold">Clients</p>
              </div>
            </div>
            <!-- Software badges -->
            <div class="mt-6 pt-5 border-t border-white/10">
              <p class="text-2xs text-text-muted uppercase tracking-wider font-semibold mb-3 text-center">
                Toolkit
              </p>
              <div class="flex flex-wrap justify-center gap-2">
                <span class="px-3 py-1 rounded-md white-pill-badge text-2xs font-semibold">
                  Premiere Pro
                </span>
                <span class="px-3 py-1 rounded-md white-pill-badge text-2xs font-semibold">
                  DaVinci Resolve
                </span>
                <span class="px-3 py-1 rounded-md white-pill-badge text-2xs font-semibold">
                  After Effects
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ============================================================
     CONTACT CTA SECTION
     ============================================================ -->
<section
  class="py-20 lg:py-28 border-t border-border relative overflow-hidden"
  aria-labelledby="contact-heading"
>
  <!-- Background glow -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 40% 60% at 50% 100%, rgba(255,0,64,0.06) 0%, transparent 70%);"
  ></div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-neon-red text-xs font-semibold tracking-widest uppercase mb-4">Let's Collaborate</p>
    <h2
      id="contact-heading"
      class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6"
    >
      Ready to Create
      <br />Something <span class="neon-text">Extraordinary?</span>
    </h2>
    <p class="text-text-secondary text-lg leading-relaxed mb-10">
      Whether you have a brief ready or just an idea, I'd love to hear about your project.
      Let's talk about how the right edit can elevate your vision.
    </p>
    <a
      href="mailto:{{ site.email }}"
      class="btn-neon text-base px-10 py-4 inline-flex"
      id="contact-cta-email"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      {{ site.email }}
    </a>
  </div>
</section>
