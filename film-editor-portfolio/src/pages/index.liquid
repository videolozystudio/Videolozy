---
layout: client
title: Film Editor Portfolio
description: Award-winning film editor specializing in commercials, short films, music videos, and documentaries.
permalink: /
---

<!-- ============================================================
     HERO SECTION — Studio Cinematic Dark Theme with Parallax
     ============================================================ -->
<section
  class="relative min-h-[88vh] flex items-center justify-center overflow-hidden py-16 sm:py-24"
  aria-labelledby="hero-headline"
  id="hero"
>
  <!-- Background Layers -->
  <div class="absolute inset-0 bg-void"></div>

  <!-- Multi-Layered Floating Parallax Ambient Orbs -->
  <div
    class="absolute top-12 left-1/5 w-[28rem] h-[28rem] rounded-full opacity-20 pointer-events-none animate-parallax-float blur-3xl"
    style="background: radial-gradient(circle, rgba(229,9,20,0.3) 0%, rgba(229,9,20,0.05) 55%, transparent 75%);"
    aria-hidden="true"
  ></div>

  <div
    class="absolute bottom-10 right-1/5 w-[30rem] h-[30rem] rounded-full opacity-15 pointer-events-none animate-parallax-reverse blur-3xl"
    style="background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(229,9,20,0.08) 55%, transparent 75%);"
    aria-hidden="true"
  ></div>

  <!-- Grid overlay with subtle grid lines -->
  <div
    class="absolute inset-0 opacity-10 pointer-events-none animate-parallax-drift"
    aria-hidden="true"
    style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"
  ></div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <!-- Pre-headline chip -->
    <div
      class="inline-flex items-center gap-2 mb-8 px-4 py-2 rounded-full
             bg-white/[0.04] border border-white/15 text-gray-300 text-xs font-medium
             tracking-widest uppercase backdrop-blur-md animate-fade-in"
      aria-label="Status: Available for work"
    >
      <span class="w-2 h-2 rounded-full bg-crimson animate-pulse"></span>
      <span>Post-Production & Editing Studio</span>
    </div>

    <!-- Main Headline -->
    <h1
      id="hero-headline"
      class="text-4xl sm:text-6xl lg:text-7xl font-black leading-[1.08] tracking-tight mb-6
             animate-fade-in"
      style="animation-delay: 0.1s; opacity: 0; animation-fill-mode: forwards;"
    >
      Visual Storytelling
      <br />
      <span class="bg-gradient-to-r from-white via-gray-200 to-crimson bg-clip-text text-transparent drop-shadow-md">
        Crafted Frame by Frame.
      </span>
    </h1>

    <!-- Tagline -->
    <p
      class="max-w-2xl mx-auto text-base sm:text-xl text-gray-400 font-normal leading-relaxed mb-10
             animate-fade-in"
      style="animation-delay: 0.25s; opacity: 0; animation-fill-mode: forwards;"
    >
      {{ site.tagline }} — Founded by lead editor <strong class="text-white">Bhuvan Bhaskar</strong>. Professional editing, precision color grading, motion graphics, and sound design for commercials, narrative, and music releases.
    </p>

    <!-- CTA Buttons -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4
             animate-fade-in"
      style="animation-delay: 0.4s; opacity: 0; animation-fill-mode: forwards;"
    >
      <a href="#work" class="btn-crimson text-sm px-8 py-3.5 w-full sm:w-auto" id="hero-cta-work">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Explore Selected Work
      </a>
      <a href="mailto:{{ site.email }}" class="btn-studio-outline text-sm px-8 py-3.5 w-full sm:w-auto">
        Contact Studio
      </a>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2
           animate-float opacity-50"
    aria-hidden="true"
  >
    <span class="text-2xs text-gray-400 font-medium tracking-widest uppercase">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-gray-400 to-transparent"></div>
  </div>
</section>

<!-- ============================================================
     STATS SECTION — Sleek Studio Glass Panels
     ============================================================ -->
<section class="py-16 border-y border-white/10 bg-surface/80 relative" aria-label="Career statistics">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">

      <div class="stat-counter p-6 rounded-2xl white-glass-card text-center group hover:border-crimson/40 transition-all duration-300" data-target="120" data-suffix="+">
        <p class="text-3xl sm:text-5xl font-extrabold text-white mb-1">
          <span class="counter-value">0</span><span class="text-crimson">+</span>
        </p>
        <p class="text-xs text-gray-400 font-medium tracking-wider uppercase">Projects Completed</p>
      </div>

      <div class="stat-counter p-6 rounded-2xl white-glass-card text-center group hover:border-crimson/40 transition-all duration-300" data-target="{{ site.yearsActive }}" data-suffix="+">
        <p class="text-3xl sm:text-5xl font-extrabold text-white mb-1">
          <span class="counter-value">0</span><span class="text-crimson">+</span>
        </p>
        <p class="text-xs text-gray-400 font-medium tracking-wider uppercase">Years Experience</p>
      </div>

      <div class="stat-counter p-6 rounded-2xl white-glass-card text-center group hover:border-crimson/40 transition-all duration-300" data-target="50" data-suffix="+">
        <p class="text-3xl sm:text-5xl font-extrabold text-white mb-1">
          <span class="counter-value">0</span><span class="text-crimson">+</span>
        </p>
        <p class="text-xs text-gray-400 font-medium tracking-wider uppercase">Brands & Studios</p>
      </div>

      <div class="stat-counter p-6 rounded-2xl white-glass-card text-center group hover:border-crimson/40 transition-all duration-300" data-target="8" data-suffix="">
        <p class="text-3xl sm:text-5xl font-extrabold text-white mb-1">
          <span class="counter-value">0</span>
          <span class="text-crimson">×</span>
        </p>
        <p class="text-xs text-gray-400 font-medium tracking-wider uppercase">Award-Winning Edits</p>
      </div>

    </div>
  </div>
</section>

<!-- ============================================================
     WORK / VIDEO GRID SECTION
     ============================================================ -->
<section
  class="py-20 lg:py-28 relative"
  id="work"
  aria-labelledby="work-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="mb-10 sm:mb-14">
      <span class="studio-pill-badge px-3.5 py-1 text-2xs font-semibold uppercase tracking-widest mb-3 inline-block rounded-full">
        Selected Work
      </span>
      <h2
        id="work-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight"
      >
        Showcase Portfolio
      </h2>
      <p class="mt-3 text-gray-400 max-w-xl text-sm sm:text-base">
        A curated selection of our commercial, narrative short film, and music video productions.
      </p>
    </div>

    <!-- Projects Grid Component -->
    {% include "components/video-grid.liquid" %}

  </div>
</section>

<!-- ============================================================
     ABOUT SECTION
     ============================================================ -->
<section
  class="py-20 lg:py-28 border-t border-white/10 relative overflow-hidden bg-surface/50"
  id="about"
  aria-labelledby="about-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Text Side -->
      <div>
        <span class="studio-pill-badge px-3.5 py-1 text-2xs font-semibold uppercase tracking-widest mb-4 inline-block rounded-full">
          About Videolozy
        </span>
        <h2
          id="about-heading"
          class="text-3xl sm:text-4xl font-extrabold text-white leading-tight mb-6"
        >
          The Studio Behind
          <br />the <span class="text-crimson">Master Cut.</span>
        </h2>
        <div class="space-y-4 text-gray-300 leading-relaxed text-sm sm:text-base">
          <p>
            Led by founder and lead editor <strong class="text-white">Bhuvan Bhaskar</strong>, <strong class="text-white">Videolozy.in</strong> is a dedicated full-time video post-production organization bringing high precision to visual storytelling.
          </p>
          <p>
            We specialize in rhythm-driven editing, color grading, motion graphics, and audio mixing — ensuring every cut lands with maximum emotion and clarity.
          </p>
        </div>

        <!-- Skills Tags -->
        <div class="mt-8 flex flex-wrap gap-2">
          {% assign skills = "Adobe Premiere Pro,DaVinci Resolve Studio,After Effects,Color Grading,Sound Design,Motion Graphics,Commercial Editing,Documentary" | split: "," %}
          {% for skill in skills %}
          <span class="px-3.5 py-1.5 rounded-full text-xs font-medium studio-pill-badge transition-colors hover:border-crimson/50 hover:text-white">
            {{ skill }}
          </span>
          {% endfor %}
        </div>

        <div class="mt-10">
          <a href="mailto:{{ site.email }}" class="btn-crimson text-sm" id="about-cta">
            Start a Conversation
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Visual Side — Studio Glass Cards -->
      <div class="relative">
        <div class="relative w-full max-w-sm mx-auto lg:ml-auto">
          <!-- Background card -->
          <div class="absolute inset-0 transform translate-x-4 translate-y-4 rounded-2xl
                      bg-white/[0.02] border border-white/10 backdrop-blur-md animate-parallax-reverse"></div>
          <!-- Front card -->
          <div class="relative rounded-2xl white-glass-card p-7 sm:p-8 shadow-2xl animate-parallax-float">
            <!-- Decorative film strip -->
            <div class="flex justify-center mb-6">
              <div class="flex gap-1.5 p-1.5 rounded-lg bg-black/60 border border-white/15">
                <div class="w-3 h-5 rounded-sm bg-crimson"></div>
                <div class="w-3 h-5 rounded-sm bg-white/30"></div>
                <div class="w-3 h-5 rounded-sm bg-white/60"></div>
                <div class="w-3 h-5 rounded-sm bg-white/30"></div>
                <div class="w-3 h-5 rounded-sm bg-crimson"></div>
                <div class="w-3 h-5 rounded-sm bg-white/30"></div>
              </div>
            </div>
            <!-- Stats grid -->
            <div class="grid grid-cols-2 gap-3 text-center">
              <div class="p-4 rounded-xl bg-black/50 border border-white/10">
                <p class="text-2xl font-bold text-crimson">120+</p>
                <p class="text-2xs text-gray-400 mt-0.5 uppercase tracking-wider font-semibold">Projects</p>
              </div>
              <div class="p-4 rounded-xl bg-black/50 border border-white/10">
                <p class="text-2xl font-bold text-white">{{ site.yearsActive }}+</p>
                <p class="text-2xs text-gray-400 mt-0.5 uppercase tracking-wider font-semibold">Years</p>
              </div>
              <div class="p-4 rounded-xl bg-black/50 border border-white/10">
                <p class="text-2xl font-bold text-white">8×</p>
                <p class="text-2xs text-gray-400 mt-0.5 uppercase tracking-wider font-semibold">Awards</p>
              </div>
              <div class="p-4 rounded-xl bg-black/50 border border-white/10">
                <p class="text-2xl font-bold text-crimson">50+</p>
                <p class="text-2xs text-gray-400 mt-0.5 uppercase tracking-wider font-semibold">Clients</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ============================================================
     CONTACT CTA SECTION
     ============================================================ -->
<section
  class="py-20 lg:py-28 border-t border-white/10 relative overflow-hidden bg-void"
  aria-labelledby="contact-heading"
>
  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="studio-pill-badge px-4 py-1.5 text-2xs font-semibold uppercase tracking-widest mb-4 inline-block rounded-full">
      Let's Work Together
    </span>
    <h2
      id="contact-heading"
      class="text-3xl sm:text-5xl font-extrabold text-white leading-tight mb-6"
    >
      Ready to Elevate
      <br />Your Next <span class="text-crimson">Video Release?</span>
    </h2>
    <p class="text-gray-300 text-base sm:text-lg leading-relaxed mb-10 max-w-xl mx-auto">
      Whether you are an agency, commercial director, or brand studio, get in touch to discuss your upcoming project.
    </p>
    <a
      href="mailto:{{ site.email }}"
      class="btn-crimson text-base px-10 py-4 inline-flex"
      id="contact-cta-email"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      {{ site.email }}
    </a>
  </div>
</section>


