---
layout: base
noindex: true
---

<!-- Admin Layout Wrapper -->
<div class="flex min-h-screen bg-void">

  <!-- ============================================================
       Sidebar Navigation
       ============================================================ -->
  <aside
    id="admin-sidebar"
    class="fixed inset-y-0 left-0 z-40 w-64 bg-surface border-r border-border flex flex-col
           transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
    aria-label="Admin navigation"
  >
    <!-- Logo / Brand -->
    <div class="flex items-center gap-3 px-6 py-5 border-b border-border">
      <div class="w-8 h-8 rounded-lg bg-neon-red flex items-center justify-center flex-shrink-0">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
        </svg>
      </div>
      <div>
        <p class="text-sm font-bold text-text-primary leading-tight">Film Reel</p>
        <p class="text-2xs text-text-muted">Admin Panel</p>
      </div>
    </div>

    <!-- Nav Links -->
    <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1" aria-label="Admin menu">

      <a href="/admin/"
         class="admin-nav-link {% if page.url == '/admin/' %}active{% endif %}"
         data-nav-item="dashboard">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Dashboard
      </a>

      <a href="/admin/projects/"
         class="admin-nav-link {% if page.url contains '/admin/projects' %}active{% endif %}"
         data-nav-item="projects">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 10l4.553-2.069A1 1 0 0121 8.878v6.243a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        Projects
      </a>

      <a href="/admin/projects/new/"
         class="admin-nav-link {% if page.url == '/admin/projects/new/' %}active{% endif %}"
         data-nav-item="new-project">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 4v16m8-8H4"/>
        </svg>
        New Project
      </a>

      <a href="/admin/settings/"
         class="admin-nav-link {% if page.url == '/admin/settings/' %}active{% endif %}"
         data-nav-item="settings">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Settings
      </a>

      <!-- Divider -->
      <div class="pt-2 mt-2 border-t border-border">
        <a href="/" target="_blank"
           class="admin-nav-link text-text-muted hover:text-text-secondary"
           data-nav-item="view-site">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          View Site
        </a>
      </div>
    </nav>

    <!-- User / Logout -->
    <div class="px-3 py-4 border-t border-border">
      <div id="admin-user-info" class="flex items-center gap-3 px-3 py-2 mb-2 rounded-lg bg-card">
        <div class="w-8 h-8 rounded-full bg-neon-red/20 flex items-center justify-center flex-shrink-0">
          <span id="admin-avatar-letter" class="text-neon-red font-semibold text-sm">A</span>
        </div>
        <div class="min-w-0 flex-1">
          <p id="admin-user-email" class="text-xs text-text-primary font-medium truncate">Loading…</p>
          <p class="text-2xs text-text-muted">Administrator</p>
        </div>
      </div>
      <button
        id="btn-logout"
        class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-text-muted
               hover:text-danger hover:bg-danger/10 transition-colors duration-200"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Sign Out
      </button>
    </div>
  </aside>

  <!-- ============================================================
       Mobile Sidebar Overlay
       ============================================================ -->
  <div
    id="sidebar-overlay"
    class="fixed inset-0 z-30 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none
           transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  ></div>

  <!-- ============================================================
       Main Content Area
       ============================================================ -->
  <div class="flex-1 flex flex-col lg:ml-64 min-w-0">

    <!-- Top Bar -->
    <header class="sticky top-0 z-20 bg-surface/80 backdrop-blur-md border-b border-border px-4 sm:px-6 py-4">
      <div class="flex items-center justify-between">
        <!-- Mobile menu toggle -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden p-2 rounded-lg text-text-secondary hover:text-text-primary
                 hover:bg-card transition-colors"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="admin-sidebar"
        >
          <svg id="menu-icon-open"  class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

        <!-- Page Title -->
        <h1 class="text-base font-semibold text-text-primary">
          {% if admin_page_title %}{{ admin_page_title }}{% else %}Admin{% endif %}
        </h1>

        <!-- Quick Actions -->
        <div class="flex items-center gap-2">
          <a href="/admin/projects/new/"
             class="btn-neon text-xs px-3 py-1.5"
             id="btn-quick-add">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Project
          </a>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main id="main-content" class="flex-1 p-4 sm:p-6 lg:p-8">
      {{ content }}
    </main>
  </div>
</div>

<!-- Admin JavaScript -->
<script type="module" src="/assets/js/admin.js"></script>

<style>
  /* Admin nav link styles (not easily done with Tailwind alone due to .active state) */
  .admin-nav-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #A0A0A0;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .admin-nav-link:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.06);
  }
  .admin-nav-link.active {
    color: #FF0040;
    background: rgba(255, 0, 64, 0.1);
    border: 1px solid rgba(255, 0, 64, 0.2);
  }
  .admin-nav-link.active svg {
    color: #FF0040;
  }
</style>
