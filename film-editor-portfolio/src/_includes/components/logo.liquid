<!-- ============================================================
     Videolozy SVG Logo Component
     Usage: {% include "components/logo.liquid" logo_size: "header" %}
     logo_size: "header" | "hero" | "splash"
     ============================================================ -->

{% assign _size = logo_size | default: "header" %}

{% if _size == "hero" %}
  {% assign _viewW = 320 %}
  {% assign _viewH = 340 %}
  {% assign _show_text = true %}
  {% assign _cls = "w-auto h-48 sm:h-56" %}
{% elsif _size == "splash" %}
  {% assign _viewW = 320 %}
  {% assign _viewH = 340 %}
  {% assign _show_text = true %}
  {% assign _cls = "w-64 sm:w-80 h-auto" %}
{% else %}
  <!-- header -->
  {% assign _viewW = 320 %}
  {% assign _viewH = 340 %}
  {% assign _show_text = false %}
  {% assign _cls = "w-auto h-10" %}
{% endif %}

<svg
  viewBox="0 0 320 340"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class="{{ _cls }} drop-shadow-[0_0_14px_rgba(255,165,0,0.35)]"
  aria-label="Videolozy Logo"
  role="img"
>
  <defs>
    <!-- Silver/white gradient for left arm of V -->
    <linearGradient id="vl-silver" x1="60" y1="20" x2="140" y2="200" gradientUnits="userSpaceOnUse">
      <stop offset="0%"  stop-color="#FFFFFF" stop-opacity="1"/>
      <stop offset="40%" stop-color="#D8D8D8" stop-opacity="1"/>
      <stop offset="100%" stop-color="#9A9A9A" stop-opacity="1"/>
    </linearGradient>

    <!-- Dark gradient for film-strip right arm -->
    <linearGradient id="vl-filmstrip" x1="200" y1="20" x2="240" y2="200" gradientUnits="userSpaceOnUse">
      <stop offset="0%"  stop-color="#555555"/>
      <stop offset="100%" stop-color="#1A1A1A"/>
    </linearGradient>

    <!-- Orange gradient for play button -->
    <linearGradient id="vl-orange" x1="0" y1="0" x2="0" y2="1" gradientUnits="objectBoundingBox">
      <stop offset="0%"  stop-color="#FFB300"/>
      <stop offset="100%" stop-color="#E07800"/>
    </linearGradient>

    <!-- Glow filter for right arm -->
    <filter id="vl-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- ==========================================
       LEFT ARM OF V — White/Silver metallic slab
       ========================================== -->
  <!-- Main left arm shape (thick ribbon going from top-left down to bottom center) -->
  <polygon
    points="48,18  92,18  160,195  134,215"
    fill="url(#vl-silver)"
  />
  <!-- Left arm subtle right edge for 3D depth -->
  <polygon
    points="92,18  100,18  168,205  160,195"
    fill="#B0B0B0"
    opacity="0.7"
  />

  <!-- ==========================================
       RIGHT ARM OF V — Film strip (dark, curled)
       ========================================== -->
  <!-- Main body of film strip arm -->
  <polygon
    points="272,18  228,18  160,195  178,210"
    fill="url(#vl-filmstrip)"
  />
  <!-- Film strip right edge highlight (the curl) -->
  <polygon
    points="228,18  248,18  260,38  242,38"
    fill="#444444"
  />
  <!-- Film strip top edge (horizontal bar) -->
  <rect x="228" y="18" width="44" height="16" rx="3" fill="#3A3A3A"/>

  <!-- Sprocket holes on right arm — row 1 (top area) -->
  <rect x="234" y="22" width="10" height="8" rx="2" fill="#111111" opacity="0.9"/>
  <rect x="250" y="22" width="10" height="8" rx="2" fill="#111111" opacity="0.9"/>

  <!-- Sprocket holes — row 2 -->
  <rect x="238" y="44" width="10" height="8" rx="2" fill="#111111" opacity="0.8"/>
  <rect x="252" y="44" width="10" height="8" rx="2" fill="#111111" opacity="0.7"/>

  <!-- Sprocket holes — row 3 -->
  <rect x="240" y="66" width="10" height="8" rx="2" fill="#111111" opacity="0.7"/>
  <rect x="253" y="66" width="10" height="8" rx="2" fill="#111111" opacity="0.6"/>

  <!-- Sprocket holes — row 4 -->
  <rect x="243" y="88" width="9"  height="7" rx="2" fill="#111111" opacity="0.6"/>
  <rect x="254" y="88" width="9"  height="7" rx="2" fill="#111111" opacity="0.5"/>

  <!-- Sprocket holes — row 5 (lower area, smaller) -->
  <rect x="246" y="108" width="8" height="6" rx="2" fill="#111111" opacity="0.5"/>
  <rect x="255" y="108" width="8" height="6" rx="2" fill="#111111" opacity="0.4"/>

  <!-- ==========================================
       ORANGE PLAY TRIANGLE — Center top of V
       ========================================== -->
  <!-- Play button triangle sitting in the V notch -->
  <polygon
    points="144,30  180,30  162,62"
    fill="url(#vl-orange)"
    filter="url(#vl-glow)"
  />

  <!-- ==========================================
       TEXT — VIDEOLOZY
       ========================================== -->
  <!-- "VIDEO" in white -->
  <text
    x="42"
    y="258"
    font-family="'Arial Black', 'Impact', sans-serif"
    font-size="52"
    font-weight="900"
    letter-spacing="2"
    fill="#FFFFFF"
  >VIDEO</text>

  <!-- "LOZY" in orange -->
  <text
    x="181"
    y="258"
    font-family="'Arial Black', 'Impact', sans-serif"
    font-size="52"
    font-weight="900"
    letter-spacing="2"
    fill="#F0A000"
  >LOZY</text>

  <!-- ==========================================
       SUBTITLE — Audio and Video Production
       ========================================== -->
  <!-- Left dash line -->
  <line x1="42" y1="278" x2="72" y2="278" stroke="#888888" stroke-width="1.5"/>
  <!-- Subtitle text -->
  <text
    x="160"
    y="282"
    text-anchor="middle"
    font-family="'Arial', sans-serif"
    font-size="11"
    font-weight="400"
    letter-spacing="3.5"
    fill="#888888"
  >AUDIO AND VIDEO PRODUCTION</text>
  <!-- Right dash line -->
  <line x1="248" y1="278" x2="278" y2="278" stroke="#888888" stroke-width="1.5"/>
</svg>
