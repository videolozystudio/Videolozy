{% comment %}
============================================================
Video Player Component
Usage: render "components/video-player", project: project
============================================================
{% endcomment %}

{% assign embed_src = project.video_id | embedUrl: project.video_provider %}

<div class="video-player-container" id="video-player-{{ project.id }}">
  <!-- 16:9 Aspect-Ratio Wrapper -->
  <div class="relative w-full rounded-xl overflow-hidden bg-black shadow-2xl"
       style="padding-bottom: 56.25%;">

    <!-- Poster frame shown before iframe loads -->
    <div
      id="player-poster-{{ project.id }}"
      class="absolute inset-0 flex items-center justify-center cursor-pointer group"
      data-video-poster
      data-embed-src="{{ embed_src }}"
    >
      <!-- Background thumbnail -->
      <img
        src="{{ project.video_id | thumbnailUrl: project.video_provider, project.thumbnail_url }}"
        alt="{{ project.title }}"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      <!-- Overlay -->
      <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition-colors duration-300"></div>

      <!-- Play Button -->
      <button
        class="relative z-10 w-20 h-20 rounded-full bg-neon-red flex items-center justify-center
               shadow-neon transform transition-all duration-300 group-hover:scale-110
               group-hover:shadow-neon-lg"
        aria-label="Play {{ project.title }}"
        data-play-btn
      >
        <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>

      <!-- Provider Badge -->
      <div class="absolute bottom-4 right-4">
        {% if project.video_provider == 'youtube' %}
        <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-black/70 text-white text-xs font-semibold">
          <svg class="w-3.5 h-3.5 text-red-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
          </svg>
          YouTube
        </span>
        {% else %}
        <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-black/70 text-white text-xs font-semibold">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.977 6.416c-.105 2.338-1.739 5.543-4.894 9.609-3.268 4.247-6.026 6.37-8.29 6.37-1.409 0-2.578-1.294-3.553-3.881L5.322 11.4C4.603 8.816 3.834 7.522 3.01 7.522c-.179 0-.806.378-1.881 1.132L0 7.197c1.185-1.044 2.351-2.084 3.501-3.128C5.08 2.701 6.266 1.984 7.055 1.91c1.867-.18 3.016 1.1 3.447 3.838.465 2.953.789 4.789.971 5.507.539 2.45 1.131 3.674 1.776 3.674.502 0 1.256-.796 2.265-2.385 1.004-1.589 1.54-2.797 1.612-3.628.144-1.371-.395-2.061-1.614-2.061-.574 0-1.167.121-1.777.391 1.186-3.868 3.434-5.757 6.762-5.637 2.473.06 3.628 1.664 3.48 4.807l-.001.004z"/>
          </svg>
          Vimeo
        </span>
        {% endif %}
      </div>
    </div>

    <!-- Iframe (injected by JS on play click) -->
    <iframe
      id="player-iframe-{{ project.id }}"
      class="absolute inset-0 w-full h-full opacity-0 transition-opacity duration-500 hidden"
      title="{{ project.title }}"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
</div>
