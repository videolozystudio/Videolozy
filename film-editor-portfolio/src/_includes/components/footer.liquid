<!-- ============================================================
     Footer Component — Client Interface
     ============================================================ -->
<footer class="border-t border-border bg-surface mt-24" id="contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">

      <!-- Brand Column -->
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4 group w-fit" aria-label="Home">
          <div class="w-9 h-9 rounded-lg bg-neon-red flex items-center justify-center
                      group-hover:shadow-neon-sm transition-shadow">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
            </svg>
          </div>
          <span class="text-base font-bold text-white">{{ site.name }}</span>
        </a>

        <p class="text-sm text-text-secondary leading-relaxed max-w-xs mb-6">
          {{ site.description }}
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-3">
          {% if site.social.vimeo != "" %}
          <a
            href="{{ site.social.vimeo }}"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-card border border-border flex items-center justify-center
                   text-text-muted hover:text-white hover:border-neon-red hover:text-neon-red
                   transition-all duration-200"
            aria-label="Vimeo Profile"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.977 6.416c-.105 2.338-1.739 5.543-4.894 9.609-3.268 4.247-6.026 6.37-8.29 6.37-1.409 0-2.578-1.294-3.553-3.881L5.322 11.4C4.603 8.816 3.834 7.522 3.01 7.522c-.179 0-.806.378-1.881 1.132L0 7.197c1.185-1.044 2.351-2.084 3.501-3.128C5.08 2.701 6.266 1.984 7.055 1.91c1.867-.18 3.016 1.1 3.447 3.838.465 2.953.789 4.789.971 5.507.539 2.45 1.131 3.674 1.776 3.674.502 0 1.256-.796 2.265-2.385 1.004-1.589 1.54-2.797 1.612-3.628.144-1.371-.395-2.061-1.614-2.061-.574 0-1.167.121-1.777.391 1.186-3.868 3.434-5.757 6.762-5.637 2.473.06 3.628 1.664 3.48 4.807l-.001.004z"/>
            </svg>
          </a>
          {% endif %}

          {% if site.social.instagram != "" %}
          <a
            href="{{ site.social.instagram }}"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-card border border-border flex items-center justify-center
                   text-text-muted hover:text-white hover:border-neon-red hover:text-neon-red
                   transition-all duration-200"
            aria-label="Instagram Profile"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          {% endif %}

          {% if site.social.linkedin != "" %}
          <a
            href="{{ site.social.linkedin }}"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-card border border-border flex items-center justify-center
                   text-text-muted hover:text-white hover:border-neon-red hover:text-neon-red
                   transition-all duration-200"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          {% endif %}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-4">Navigation</h3>
        <ul class="space-y-2.5">
          {% for item in site.nav %}
          <li>
            <a
              href="{{ item.href }}"
              class="text-sm text-text-secondary hover:text-white transition-colors"
            >
              {{ item.label }}
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Contact Column -->
      <div>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-4">Get In Touch</h3>
        <p class="text-sm text-text-secondary mb-4 leading-relaxed">
          Available for freelance projects and long-term collaborations.
        </p>
        <a
          href="mailto:{{ site.email }}"
          class="inline-flex items-center gap-2 text-sm font-medium text-neon-red hover:text-neon-red-600
                 transition-colors group"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          {{ site.email }}
          <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-muted">
        &copy; {{ site.buildYear }} {{ site.name }}. All rights reserved.
      </p>
      <p class="text-xs text-text-muted">
        Crafted with <span class="text-neon-red">&#9632;</span> precision &amp; passion
      </p>
    </div>
  </div>
</footer>
