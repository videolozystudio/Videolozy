<!-- ============================================================
     Footer Component — Client Interface
     ============================================================ -->
<footer class="border-t border-border bg-surface mt-24" id="contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">

      <!-- Brand Column -->
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4 group w-fit" aria-label="Home">
          <!-- Logo mark — V film strip -->
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"
               class="w-9 h-9 flex-shrink-0 group-hover:drop-shadow-[0_0_10px_rgba(255,0,64,0.6)] transition-all duration-300"
               aria-hidden="true">
            <path d="M7 9 L20 31 L33 9" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="3"    y="6"  width="5.5" height="3.5" rx="1" fill="white" opacity="0.38"/>
            <rect x="3"    y="12" width="5.5" height="3.5" rx="1" fill="white" opacity="0.38"/>
            <rect x="31.5" y="6"  width="5.5" height="3.5" rx="1" fill="white" opacity="0.38"/>
            <rect x="31.5" y="12" width="5.5" height="3.5" rx="1" fill="white" opacity="0.38"/>
            <circle cx="20" cy="31" r="2.6" fill="#FF0040"/>
            <circle cx="20" cy="31" r="5"   fill="none" stroke="#FF0040" stroke-width="1" opacity="0.3"/>
          </svg>
          <span class="text-base font-bold text-white tracking-wide">{{ site.brand }}</span>
        </a>

        <p class="text-sm text-text-secondary leading-relaxed max-w-xs mb-6">
          {{ site.description }}
        </p>

        <!-- Social Links — Facebook, Instagram, WhatsApp, Mail -->
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-3">Contact Us</h3>
        <div class="flex items-center gap-3 mb-6">

          <!-- Facebook -->
          <a
            href="{{ site.social.facebook }}"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn group"
            aria-label="Facebook"
            id="footer-facebook"
          >
            <svg class="w-4 h-4 text-[#1877F2] group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="{{ site.social.instagram }}"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn group"
            aria-label="Instagram"
            id="footer-instagram"
          >
            <svg class="w-4 h-4 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%">
                  <stop offset="0%"   stop-color="#FFDC80"/>
                  <stop offset="25%"  stop-color="#FCAF45"/>
                  <stop offset="50%"  stop-color="#F77737"/>
                  <stop offset="75%"  stop-color="#F56040"/>
                  <stop offset="100%" stop-color="#833AB4"/>
                </linearGradient>
              </defs>
              <path fill="url(#ig-grad)" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href="{{ site.social.whatsapp }}"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn group"
            aria-label="WhatsApp"
            id="footer-whatsapp"
          >
            <svg class="w-4 h-4 text-[#25D366] group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>

          <!-- Mail -->
          <a
            href="mailto:{{ site.email }}"
            class="social-icon-btn group"
            aria-label="Email"
            id="footer-email"
          >
            <svg class="w-4 h-4 text-neon-yellow group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>

        </div>

        <!-- Address -->
        <address class="not-italic text-sm text-text-muted leading-relaxed space-y-0.5">
          <p class="text-white font-semibold mb-1">Videolozy</p>
          <p>Kulahriya lane, Mithila colony</p>
          <p>Nasriganj, Danapur, Patna 800012</p>
          <p class="pt-1.5"><a href="tel:{{ site.phoneRaw }}" class="text-neon-yellow hover:underline transition-colors font-medium">{{ site.phone }}</a></p>
        </address>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-4">Navigation</h3>
        <ul class="space-y-2.5">
          {% for item in site.nav %}
          <li>
            <a
              href="{{ item.href }}"
              class="text-sm text-text-secondary hover:text-white transition-colors"
            >
              {{ item.label }}
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Contact Column -->
      <div>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-4">Get In Touch</h3>
        <p class="text-sm text-text-secondary mb-4 leading-relaxed">
          Available for freelance projects and long-term collaborations.
        </p>
        <div class="space-y-3">
          <a
            href="mailto:{{ site.email }}"
            class="inline-flex items-center gap-2 text-sm font-medium text-neon-silver hover:text-neon-silver-600
                   transition-colors group"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {{ site.email }}
            <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <div>
            <a
              href="tel:{{ site.phoneRaw }}"
              class="inline-flex items-center gap-2 text-sm font-medium text-neon-silver hover:text-neon-silver-600
                     transition-colors group"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {{ site.phone }}
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-muted">
        &copy; {{ site.buildYear }} {{ site.name }}. All rights reserved.
      </p>
      <p class="text-xs text-text-muted">
        Crafted with <span class="text-neon-yellow">&#9632;</span> precision &amp; passion
      </p>
    </div>
  </div>
</footer>
