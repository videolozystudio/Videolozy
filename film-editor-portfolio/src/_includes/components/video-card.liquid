{% comment %}
============================================================
Video Card Component
Usage: render "components/video-card", project: project
============================================================
{% endcomment %}

{% assign embed_url = project.video_id | embedUrl: project.video_provider %}
{% assign thumb_url = project.video_id | thumbnailUrl: project.video_provider, project.thumbnail_url %}
{% assign project_slug = project.title | slugify %}

<article
  class="card-project group"
  data-category="{{ project.category }}"
  data-id="{{ project.id }}"
  data-project-card
>
  <!-- Thumbnail Link -->
  <a
    href="/projects/detail/?id={{ project.id }}"
    class="block relative overflow-hidden aspect-video bg-card"
    aria-label="Watch {{ project.title }}"
    tabindex="0"
  >
    <!-- Thumbnail Image (lazy-loaded WebP) -->
    <img
      src="{{ thumb_url }}"
      alt="{{ project.title }} — {{ project.category | categoryLabel }} by {{ project.client_name }}"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      decoding="async"
      width="640"
      height="360"
      onerror="this.src='/assets/images/placeholder-thumb.svg'"
    />

    <!-- Dark overlay gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent
                opacity-60 group-hover:opacity-80 transition-opacity duration-300"></div>

    <!-- Play button overlay -->
    <div
      class="absolute inset-0 flex items-center justify-center
             opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      aria-hidden="true"
    >
      <div
        class="w-14 h-14 rounded-full bg-neon-red/90 flex items-center justify-center
               shadow-neon transform scale-90 group-hover:scale-100 transition-transform duration-300"
      >
        <svg class="w-6 h-6 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
    </div>

    <!-- Featured Badge -->
    {% if project.is_featured %}
    <div class="absolute top-3 left-3">
      <span class="badge bg-neon-red text-white text-2xs">
        ★ Featured
      </span>
    </div>
    {% endif %}

    <!-- Category Badge -->
    <div class="absolute top-3 right-3">
      <span class="badge bg-black/60 text-text-secondary border border-white/10 text-2xs">
        {{ project.category | categoryLabel }}
      </span>
    </div>
  </a>

  <!-- Card Body -->
  <div class="p-4 sm:p-5">
    <!-- Title -->
    <h3 class="font-semibold text-text-primary text-base leading-snug mb-1
               group-hover:text-neon-red transition-colors duration-200">
      <a href="/projects/detail/?id={{ project.id }}" class="stretched-link-text">
        {{ project.title }}
      </a>
    </h3>

    <!-- Meta Row -->
    <div class="flex items-center gap-3 text-xs text-text-muted mb-3">
      {% if project.client_name != "" %}
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
        {{ project.client_name }}
      </span>
      {% endif %}
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        {{ project.year }}
      </span>
    </div>

    <!-- Description -->
    <p class="text-sm text-text-muted leading-relaxed line-clamp-2">
      {{ project.description | truncate: 100 }}
    </p>

    <!-- Footer Row -->
    <div class="mt-4 pt-4 border-t border-border flex items-center justify-between">
      <!-- View count -->
      <span class="flex items-center gap-1.5 text-xs text-text-muted">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        <span class="view-counter" data-project-id="{{ project.id }}">
          {{ project.view_count | formatNumber }}
        </span>
        views
      </span>

      <!-- Watch Link -->
      <a
        href="/projects/detail/?id={{ project.id }}"
        class="text-xs font-semibold text-neon-red hover:text-neon-red-600
               flex items-center gap-1 transition-colors"
        aria-label="Watch {{ project.title }}"
      >
        Watch
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>
