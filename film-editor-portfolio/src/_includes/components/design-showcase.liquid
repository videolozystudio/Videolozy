{% comment %}
===========================================================================
design-showcase.liquid — Premium animated design showcase section

Configuration (set before {% include %} in parent template):
  {% assign ds_hl1       = "A Design Partner" %}
  {% assign ds_hl2       = "You Can Trust." %}
  {% assign ds_anim_dur  = "22s" %}
  {% assign ds_tagline   = "Post-Production Studio · Bhuvan Bhaskar" %}
===========================================================================
{% endcomment %}

{% assign _hl1      = ds_hl1      | default: "A Design Partner" %}
{% assign _hl2      = ds_hl2      | default: "You Can Trust." %}
{% assign _animdur  = ds_anim_dur | default: "22s" %}
{% assign _tagline  = ds_tagline  | default: "Post-Production Studio · Bhuvan Bhaskar" %}

<section
  id="design-showcase"
  class="ds-section"
  aria-label="Design Showcase — Videolozy"
>
  <!-- Edge vignette -->
  <div class="ds-vignette" aria-hidden="true"></div>

  <!-- ── Static header: logo + headline ─────────────────────── -->
  <header class="ds-header">

    <!-- Videolozy logo -->
    <a href="/" class="ds-logo" aria-label="Videolozy — Home">
      <svg class="ds-logo-mark" viewBox="0 0 40 40" fill="none"
           xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Film-strip V -->
        <path d="M7 9 L20 31 L33 9"
              stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Sprocket holes left -->
        <rect x="3"  y="6"  width="5.5" height="3.5" rx="1" fill="white" opacity="0.38"/>
        <rect x="3"  y="12" width="5.5" height="3.5" rx="1" fill="white" opacity="0.38"/>
        <!-- Sprocket holes right -->
        <rect x="31.5" y="6"  width="5.5" height="3.5" rx="1" fill="white" opacity="0.38"/>
        <rect x="31.5" y="12" width="5.5" height="3.5" rx="1" fill="white" opacity="0.38"/>
        <!-- Red base dot -->
        <circle cx="20" cy="31" r="2.6" fill="#e63030"/>
        <circle cx="20" cy="31" r="5"   fill="none" stroke="#e63030" stroke-width="1" opacity="0.3"/>
      </svg>
      <span class="ds-logo-wordmark" aria-hidden="true">VIDEOLOZY</span>
    </a>

    <!-- Headline -->
    <h2 class="ds-headline">
      <span class="ds-hl1">{{ _hl1 }}</span>
      <span class="ds-hl2">{{ _hl2 }}</span>
    </h2>

    <p class="ds-tagline">{{ _tagline }}</p>

  </header>

  <!-- ── 3D card stage ───────────────────────────────────────── -->
  <div class="ds-stage" aria-hidden="true">
    <div class="ds-canvas" id="dsCanvas" data-anim-dur="{{ _animdur }}"></div>
  </div>

</section>

<!-- ── Component styles ──────────────────────────────────────── -->
<style>
/* =========================================================
   Design Showcase — scoped to .ds- namespace
   ========================================================= */

.ds-section {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 640px;
  background: #0b0d10;
  overflow: hidden;
  font-family: 'Inter', 'Helvetica Neue', -apple-system, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ── Vignette ── */
.ds-vignette {
  position: absolute;
  inset: 0;
  z-index: 15;
  pointer-events: none;
  background:
    radial-gradient(ellipse 90% 80% at 50% 50%, transparent 30%, rgba(11,13,16,.7) 100%),
    linear-gradient(to right,  rgba(11,13,16,.6) 0%, transparent 14%, transparent 86%, rgba(11,13,16,.6) 100%),
    linear-gradient(to bottom, rgba(11,13,16,.3) 0%, transparent 22%, transparent 62%, rgba(11,13,16,.75) 100%);
}

/* ── Header ── */
.ds-header {
  position: absolute;
  top: 8%;
  left: 6%;
  z-index: 20;
  max-width: 580px;
  pointer-events: auto;
}

/* ── Logo ── */
.ds-logo {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  text-decoration: none;
  margin-bottom: 42px;
  opacity: 0.9;
  transition: opacity .25s;
}
.ds-logo:hover { opacity: 1; }

.ds-logo-mark { width: 34px; height: 34px; flex-shrink: 0; }

.ds-logo-wordmark {
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: .24em;
  color: rgba(255,255,255,.85);
  text-transform: uppercase;
  line-height: 1;
}

/* ── Headline ── */
.ds-headline {
  display: flex;
  flex-direction: column;
  font-size: clamp(42px, 5.4vw, 70px);
  font-weight: 300;
  line-height: 1.0;
  letter-spacing: -.034em;
  color: #fff;
  margin: 0 0 18px;
}
.ds-hl1,
.ds-hl2 { display: block; }

/* ── Tagline ── */
.ds-tagline {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .14em;
  color: rgba(255,255,255,.28);
  text-transform: uppercase;
  line-height: 1;
}

/* ── Stage ── */
.ds-stage {
  position: absolute;
  inset: 0;
  z-index: 5;
}

/* ── Canvas ── */
.ds-canvas {
  position: absolute;
  left: -440px;
  top: -60px;
  width: 2900px;
  height: 1800px;
  will-change: transform;
  transform-origin: 50% 82%;
  animation: ds-pan var(--anim-dur, 22s) ease-in-out infinite alternate;
}

@keyframes ds-pan {
  0%   { transform: perspective(1380px) rotateX(7deg) translate3d(0px,    0px, 0px); }
  100% { transform: perspective(1380px) rotateX(7deg) translate3d(-360px, -30px, 0px); }
}

/* ── Cards ── */
.ds-card {
  position: absolute;
  border-radius: 14px;
  overflow: hidden;
  box-shadow:
    0 28px 70px rgba(0,0,0,.58),
    0  8px 24px rgba(0,0,0,.45),
    0  2px  8px rgba(0,0,0,.35);
  will-change: transform;
  transform-origin: center center;
}
.ds-card svg { display: block; width: 100%; height: 100%; }

@keyframes ds-float {
  from { transform: rotate(var(--rot,0deg)) translateY(0px)          translateZ(0); }
  to   { transform: rotate(var(--rot,0deg)) translateY(var(--fy,-8px)) translateZ(0); }
}

/* ── Responsive ─ tablet ── */
@media (max-width: 1024px) {
  .ds-canvas { left: -280px; top: -40px; width: 2200px; height: 1500px; }
}

/* ── Responsive ─ mobile ── */
@media (max-width: 768px) {
  .ds-section  { min-height: 580px; }
  .ds-header   { top: 7%; left: 5%; max-width: 88%; }
  .ds-logo     { margin-bottom: 26px; }
  .ds-headline { font-size: clamp(38px, 10.5vw, 46px); letter-spacing: -.026em; }
  .ds-canvas   { left: -140px; top: -20px; width: 1600px; height: 1300px; }

  @keyframes ds-pan {
    0%   { transform: perspective(900px) rotateX(5deg) translate3d(0px,    0px, 0px); }
    100% { transform: perspective(900px) rotateX(5deg) translate3d(-210px, -18px, 0px); }
  }
}

/* ── Responsive ─ small mobile ── */
@media (max-width: 480px) {
  .ds-canvas { left: -70px; top: -10px; width: 1200px; height: 1100px; }

  @keyframes ds-pan {
    0%   { transform: perspective(700px) rotateX(4deg) translate3d(0px,   0px, 0px); }
    100% { transform: perspective(700px) rotateX(4deg) translate3d(-160px,-14px, 0px); }
  }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .ds-canvas  { animation: none !important; transform: perspective(1380px) rotateX(7deg) translate3d(-130px,-14px,0); }
  .ds-card    { animation: none !important; }
}
</style>

<!-- ── Component script ───────────────────────────────────────── -->
<script>
(function () {
  'use strict';

  /* ============================================================
     SVG ARTWORK LIBRARY
     Each function receives (w, h) and returns an SVG string.
     Gradient IDs are prefixed with card id to prevent conflicts.
  ============================================================ */
  const ART = {

    /* 1 ── EDIT Typography ─────────────────────────────────── */
    typeEdit: (w, h, id) => {
      const fs = Math.floor(h * 0.58);
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="${id}bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"   stop-color="#06060b"/>
            <stop offset="100%" stop-color="#0e0a18"/>
          </linearGradient>
          <pattern id="${id}sl" width="4" height="4" patternUnits="userSpaceOnUse">
            <rect y="0" width="4" height="1" fill="rgba(255,255,255,.018)"/>
          </pattern>
        </defs>
        <rect width="${w}" height="${h}" fill="url(#${id}bg)"/>
        <rect width="${w}" height="${h}" fill="url(#${id}sl)" opacity=".5"/>
        <text x="-6" y="${Math.floor(h*.76)}"
          font-family="Inter,'Arial Black',sans-serif"
          font-size="${fs}" font-weight="900" fill="white" opacity=".97"
          letter-spacing="-5">EDIT</text>
        <rect x="0" y="${Math.floor(h*.82)}" width="${Math.floor(w*.44)}" height="3" fill="#e63030"/>
        <text x="5" y="${Math.floor(h*.95)}"
          font-family="Inter,Arial,sans-serif" font-size="9" font-weight="600"
          fill="rgba(255,255,255,.3)" letter-spacing="3">FILM EDITING · POST PRODUCTION</text>
        <rect x="${Math.floor(w*.915)}" y="0" width="${Math.floor(w*.085)}" height="${h}" fill="#e63030" opacity=".055"/>
      </svg>`;
    },

    /* 2 ── Color Grade ─────────────────────────────────────── */
    colorGrade: (w, h, id) => `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="${id}bg" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%"   stop-color="#041a18"/>
          <stop offset="48%"  stop-color="#0b3d3a"/>
          <stop offset="52%"  stop-color="#5c1a04"/>
          <stop offset="100%" stop-color="#3d1004"/>
        </linearGradient>
      </defs>
      <rect width="${w}" height="${h}" fill="url(#${id}bg)"/>
      <line x1="${w/2}" y1="0" x2="${w/2}" y2="${h}" stroke="rgba(255,255,255,.14)" stroke-width="1"/>
      <text x="${w*.14}" y="${h*.12}" font-family="Inter,Arial,sans-serif" font-size="8.5" font-weight="700"
        fill="rgba(255,255,255,.42)" letter-spacing="3">SHADOWS</text>
      <text x="${w*.56}" y="${h*.12}" font-family="Inter,Arial,sans-serif" font-size="8.5" font-weight="700"
        fill="rgba(255,255,255,.42)" letter-spacing="3">HIGHLIGHTS</text>
      <circle cx="${w*.26}" cy="${h*.52}" r="${Math.min(w,h)*.22}" fill="none" stroke="rgba(0,240,200,.22)" stroke-width="2"/>
      <circle cx="${w*.26}" cy="${h*.52}" r="${Math.min(w,h)*.12}" fill="rgba(0,200,180,.14)"/>
      <circle cx="${w*.74}" cy="${h*.52}" r="${Math.min(w,h)*.22}" fill="none" stroke="rgba(255,140,50,.22)" stroke-width="2"/>
      <circle cx="${w*.74}" cy="${h*.52}" r="${Math.min(w,h)*.12}" fill="rgba(230,100,20,.14)"/>
      <text x="${w*.5}" y="${h*.93}" font-family="Inter,Arial,sans-serif" font-size="10" font-weight="700"
        fill="rgba(255,255,255,.42)" letter-spacing="5" text-anchor="middle">COLOR GRADE</text>
    </svg>`,

    /* 3 ── UI Dashboard ────────────────────────────────────── */
    uiDashboard: (w, h, id) => {
      const barW = (w * .88) / 8;
      const vals = [.55,.72,.48,.85,.63,.91,.70,.58];
      const bars = vals.map((v, i) => {
        const bx = w * .06 + i * (barW + 3);
        const bh = h * .28 * v;
        const by = h * .87 - bh;
        const colors = ['#60aaff','#80c8ff','#40a0ff','#a0d0ff','#60b8ff','#b0dcff','#70b4ff','#50aaff'];
        return `<rect x="${bx}" y="${by}" width="${barW}" height="${bh}" rx="3" fill="${colors[i]}" opacity="${.3 + v*.42}"/>`;
      }).join('');
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <rect width="${w}" height="${h}" fill="#0d1829"/>
        <rect width="${w}" height="${h*.13}" fill="#08101e"/>
        <circle cx="${w*.055}" cy="${h*.065}" r="3.5" fill="#e63030" opacity=".8"/>
        <circle cx="${w*.115}" cy="${h*.065}" r="3.5" fill="#ffe600" opacity=".8"/>
        <circle cx="${w*.175}" cy="${h*.065}" r="3.5" fill="#1ee6a0" opacity=".8"/>
        <text x="${w*.27}" y="${h*.09}" font-family="Inter,Arial,sans-serif" font-size="9.5" fill="rgba(255,255,255,.35)">videolozy — render engine</text>
        <rect x="${w*.04}" y="${h*.18}" width="${w*.27}" height="${h*.22}" rx="5" fill="#111e34"/>
        <text x="${w*.09}" y="${h*.285}" font-family="Inter,Arial,sans-serif" font-size="19" font-weight="800" fill="white">2.4M</text>
        <text x="${w*.09}" y="${h*.375}" font-family="Inter,Arial,sans-serif" font-size="7.5" fill="rgba(255,255,255,.38)" letter-spacing="1.5">FRAMES RENDERED</text>
        <rect x="${w*.36}" y="${h*.18}" width="${w*.27}" height="${h*.22}" rx="5" fill="#111e34"/>
        <text x="${w*.41}" y="${h*.285}" font-family="Inter,Arial,sans-serif" font-size="19" font-weight="800" fill="#ffe600">120+</text>
        <text x="${w*.41}" y="${h*.375}" font-family="Inter,Arial,sans-serif" font-size="7.5" fill="rgba(255,255,255,.38)" letter-spacing="1.5">TIMELINES</text>
        <rect x="${w*.68}" y="${h*.18}" width="${w*.28}" height="${h*.22}" rx="5" fill="#111e34"/>
        <text x="${w*.73}" y="${h*.285}" font-family="Inter,Arial,sans-serif" font-size="19" font-weight="800" fill="#a0c8ff">98%</text>
        <text x="${w*.73}" y="${h*.375}" font-family="Inter,Arial,sans-serif" font-size="7.5" fill="rgba(255,255,255,.38)" letter-spacing="1.5">RENDER QUALITY</text>
        ${bars}
        <line x1="${w*.04}" y1="${h*.87}" x2="${w*.96}" y2="${h*.87}" stroke="rgba(255,255,255,.07)" stroke-width="1"/>
      </svg>`;
    },

    /* 4 ── Motion Abstract ─────────────────────────────────── */
    motionAbstract: (w, h, id) => {
      const cx = w / 2, cy = h / 2;
      const r = Math.min(w, h);
      const rays = Array.from({length: 6}, (_, i) => {
        const a = (i * 60 + 15) * Math.PI / 180;
        return `<line x1="${cx+Math.cos(a)*r*.17}" y1="${cy+Math.sin(a)*r*.17}" x2="${cx+Math.cos(a)*r*.42}" y2="${cy+Math.sin(a)*r*.42}" stroke="rgba(130,80,255,.18)" stroke-width="1"/>`;
      }).join('');
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="${id}bg" cx="50%" cy="50%">
            <stop offset="0%"   stop-color="#130830"/>
            <stop offset="100%" stop-color="#080420"/>
          </radialGradient>
          <radialGradient id="${id}glow" cx="50%" cy="50%">
            <stop offset="0%"   stop-color="#6020e0" stop-opacity=".45"/>
            <stop offset="100%" stop-color="#6020e0" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <rect width="${w}" height="${h}" fill="url(#${id}bg)"/>
        <ellipse cx="${cx}" cy="${cy}" rx="${w*.55}" ry="${h*.55}" fill="url(#${id}glow)"/>
        <circle cx="${cx}" cy="${cy}" r="${r*.36}" fill="none" stroke="rgba(100,40,220,.22)" stroke-width="1.5" stroke-dasharray="8 6"/>
        <circle cx="${cx}" cy="${cy}" r="${r*.26}" fill="none" stroke="rgba(60,120,255,.28)" stroke-width="1.5" stroke-dasharray="12 4"/>
        <circle cx="${cx}" cy="${cy}" r="${r*.15}" fill="rgba(80,60,200,.18)" stroke="rgba(120,80,255,.48)" stroke-width="1.5"/>
        ${rays}
        <circle cx="${cx}" cy="${cy}" r="5" fill="#8060ff"/>
        <text x="${cx}" y="${h*.1}" font-family="Inter,Arial,sans-serif" font-size="8" font-weight="500"
          fill="rgba(255,255,255,.22)" text-anchor="middle" letter-spacing="2">ANIMATION</text>
        <text x="${cx}" y="${h*.93}" font-family="Inter,Arial,sans-serif" font-size="9.5" font-weight="700"
          fill="rgba(140,100,255,.55)" text-anchor="middle" letter-spacing="6">MOTION GRAPHICS</text>
      </svg>`;
    },

    /* 5 ── Cinema Frame ────────────────────────────────────── */
    cinemaFrame: (w, h, id) => {
      const bar = Math.floor(h * .13);
      const mid = h - bar * 2;
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="${id}mid" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"   stop-color="#0a2a40"/>
            <stop offset="40%"  stop-color="#1a3a5c"/>
            <stop offset="70%"  stop-color="#3d2010"/>
            <stop offset="100%" stop-color="#2a1408"/>
          </linearGradient>
        </defs>
        <rect width="${w}" height="${h}" fill="#000"/>
        <rect x="0" y="${bar}" width="${w}" height="${mid}" fill="url(#${id}mid)"/>
        <line x1="${w*.333}" y1="${bar}" x2="${w*.333}" y2="${bar+mid}" stroke="rgba(255,255,255,.07)" stroke-width="1"/>
        <line x1="${w*.667}" y1="${bar}" x2="${w*.667}" y2="${bar+mid}" stroke="rgba(255,255,255,.07)" stroke-width="1"/>
        <line x1="0" y1="${bar+mid*.333}" x2="${w}" y2="${bar+mid*.333}" stroke="rgba(255,255,255,.07)" stroke-width="1"/>
        <line x1="0" y1="${bar+mid*.667}" x2="${w}" y2="${bar+mid*.667}" stroke="rgba(255,255,255,.07)" stroke-width="1"/>
        <circle cx="${w*.5}" cy="${bar+mid*.5}" r="3.5" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1"/>
        <rect x="0" y="${bar}" width="7" height="2" fill="rgba(255,255,255,.28)"/>
        <rect x="0" y="${bar+mid-2}" width="7" height="2" fill="rgba(255,255,255,.28)"/>
        <rect x="${w-7}" y="${bar}" width="7" height="2" fill="rgba(255,255,255,.28)"/>
        <rect x="${w-7}" y="${bar+mid-2}" width="7" height="2" fill="rgba(255,255,255,.28)"/>
        <text x="${w*.5}" y="${bar*.62}" font-family="'Courier New',monospace" font-size="8.5" font-weight="700"
          fill="rgba(255,255,255,.38)" text-anchor="middle" letter-spacing="3">00:01:42:08</text>
        <text x="${w*.08}" y="${bar+mid+bar*.64}" font-family="Inter,Arial,sans-serif" font-size="7.5"
          fill="rgba(255,255,255,.38)" letter-spacing="2">2.39:1 SCOPE</text>
        <text x="${w*.75}" y="${bar+mid+bar*.64}" font-family="Inter,Arial,sans-serif" font-size="7.5"
          fill="rgba(255,255,255,.38)" letter-spacing="2">4K DCI</text>
      </svg>`;
    },

    /* 6 ── Audio Waveform ──────────────────────────────────── */
    audioWave: (w, h, id) => {
      const BARS = 40;
      const vals = [.22,.36,.50,.65,.70,.80,.90,.86,.76,.89,.95,.92,.86,.78,.73,.66,.60,.70,.80,.93,.98,.95,.88,.82,.76,.68,.61,.72,.81,.89,.93,.82,.74,.65,.58,.70,.78,.68,.55,.42];
      const bw = (w * .86) / BARS;
      const mid = h * .5;
      const amp = h * .40;
      const colors = ['#1ee6a0','#00aaff','#ff8a00'];
      const bars = vals.slice(0, BARS).map((v, i) => {
        const bx = w * .07 + i * (bw + 2.5);
        const bh = amp * v;
        const c = colors[i < 14 ? 0 : i < 28 ? 1 : 2];
        return `<rect x="${bx}" y="${mid-bh/2}" width="${bw}" height="${bh}" rx="2" fill="${c}" opacity=".72"/>`;
      }).join('');
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <rect width="${w}" height="${h}" fill="#030608"/>
        ${bars}
        <line x1="${w*.36}" y1="${h*.08}" x2="${w*.36}" y2="${h*.92}" stroke="rgba(255,255,255,.55)" stroke-width="1.5"/>
        <polygon points="${w*.36},${h*.08} ${w*.36+6},${h*.03} ${w*.36-6},${h*.03}" fill="rgba(255,255,255,.7)"/>
        <text x="${w*.07}" y="${h*.09}" font-family="Inter,Arial,sans-serif" font-size="8" fill="rgba(255,255,255,.32)" letter-spacing="2">SOUND DESIGN</text>
        <text x="${w*.07}" y="${h*.94}" font-family="'Courier New',monospace" font-size="7.5" fill="rgba(255,255,255,.22)" letter-spacing="1">00:00:03.42</text>
        <text x="${w*.72}" y="${h*.94}" font-family="'Courier New',monospace" font-size="7.5" fill="rgba(255,255,255,.22)" letter-spacing="1">48kHz · 24bit</text>
      </svg>`;
    },

    /* 7 ── Featured Project (Centerpiece) ──────────────────── */
    featuredProject: (w, h, id) => `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="${id}bg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%"   stop-color="#0c0c10"/>
          <stop offset="60%"  stop-color="#100a20"/>
          <stop offset="100%" stop-color="#0c0810"/>
        </linearGradient>
        <radialGradient id="${id}glow" cx="25%" cy="65%">
          <stop offset="0%"   stop-color="#e63030" stop-opacity=".14"/>
          <stop offset="100%" stop-color="#e63030" stop-opacity="0"/>
        </radialGradient>
        <pattern id="${id}sl" width="4" height="4" patternUnits="userSpaceOnUse">
          <rect y="0" width="4" height="1" fill="rgba(255,255,255,.012)"/>
        </pattern>
      </defs>
      <rect width="${w}" height="${h}" fill="url(#${id}bg)"/>
      <rect width="${w}" height="${h}" fill="url(#${id}glow)"/>
      <rect width="${w}" height="${h}" fill="url(#${id}sl)" opacity=".4"/>
      <!-- Faint V watermark -->
      <path d="M${w*.07} ${h*.18} L${w*.185} ${h*.65} L${w*.30} ${h*.18}"
        stroke="rgba(255,255,255,.08)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <!-- VIDEOLOZY wordmark -->
      <text x="${w*.06}" y="${h*.52}"
        font-family="Inter,'Arial Black',sans-serif"
        font-size="${Math.floor(w*.132)}" font-weight="900"
        fill="white" letter-spacing="-2" opacity=".96">VIDEOLOZY</text>
      <!-- Red rule -->
      <rect x="${w*.06}" y="${h*.59}" width="${w*.62}" height="2.5" fill="#e63030"/>
      <!-- Subtitle -->
      <text x="${w*.06}" y="${h*.73}"
        font-family="Inter,Arial,sans-serif" font-size="12" font-weight="300"
        fill="rgba(255,255,255,.5)" letter-spacing="7">SHOWREEL 2024</text>
      <!-- Bottom byline -->
      <text x="${w*.06}" y="${h*.91}"
        font-family="Inter,Arial,sans-serif" font-size="8.5" font-weight="500"
        fill="rgba(255,255,255,.28)" letter-spacing="2">POST-PRODUCTION · BHUVAN BHASKAR</text>
      <!-- Status dot -->
      <circle cx="${w*.91}" cy="${h*.12}" r="4.5" fill="#e63030" opacity=".85"/>
      <circle cx="${w*.91}" cy="${h*.12}" r="10"  fill="none" stroke="#e63030" stroke-width="1" opacity=".28"/>
    </svg>`,

    /* 8 ── Timeline UI ─────────────────────────────────────── */
    timelineUI: (w, h, id) => {
      const tracks = [
        { y: .21, c: '#e63030', l: 'VIDEO',  s: [.05,.44,.51,.85] },
        { y: .37, c: '#ffe600', l: 'AUDIO',  s: [.05,.37,.54,.78] },
        { y: .53, c: '#1ee6a0', l: 'FX',     s: [.20,.50,.60,.82] },
        { y: .69, c: '#60aaff', l: 'TEXT',   s: [.10,.31,.70,.90] },
      ];
      const TH = h * .09;
      const body = tracks.map(t => {
        const segs = [];
        for (let i = 0; i < t.s.length; i += 2) {
          const sx = w * t.s[i], sw = w * (t.s[i+1] - t.s[i]);
          segs.push(`<rect x="${sx}" y="${h*t.y}" width="${sw}" height="${TH}" rx="3" fill="${t.c}" opacity=".55"/>`);
        }
        return `<text x="${w*.01}" y="${h*t.y + TH*.72}"
          font-family="Inter,monospace" font-size="7" fill="rgba(255,255,255,.28)" letter-spacing="1">${t.l}</text>
          ${segs.join('')}`;
      }).join('');
      const marks = [.1,.2,.3,.4,.5,.6,.7,.8,.9].map(x =>
        `<line x1="${w*x}" y1="${h*.14}" x2="${w*x}" y2="${h*.82}" stroke="rgba(255,255,255,.04)" stroke-width="1"/>`
      ).join('');
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <rect width="${w}" height="${h}" fill="#050810"/>
        <rect width="${w}" height="${h*.14}" fill="#08101e"/>
        <text x="${w*.04}" y="${h*.092}" font-family="'Courier New',monospace" font-size="9" fill="rgba(255,255,255,.38)" letter-spacing="2">TIMELINE — 00:02:14.08</text>
        ${marks}
        ${body}
        <line x1="${w*.35}" y1="${h*.14}" x2="${w*.35}" y2="${h*.84}" stroke="rgba(255,255,255,.58)" stroke-width="1.5"/>
        <polygon points="${w*.35},${h*.13} ${w*.35+7},${h*.07} ${w*.35-7},${h*.07}" fill="white"/>
        <rect x="0" y="${h*.84}" width="${w}" height="${h*.16}" fill="#08101e"/>
        <text x="${w*.04}" y="${h*.94}" font-family="Inter,Arial,sans-serif" font-size="7.5" fill="rgba(255,255,255,.22)" letter-spacing="2">VIDEO EDITING · VIDEOLOZY</text>
      </svg>`;
    },

    /* 9 ── Brand Identity ──────────────────────────────────── */
    brandIdentity: (w, h, id) => `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="${id}dots" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="10" cy="10" r=".9" fill="rgba(0,0,0,.07)"/>
        </pattern>
      </defs>
      <rect width="${w}" height="${h}" fill="#f4efe6"/>
      <rect width="${w}" height="${h}" fill="url(#${id}dots)"/>
      <!-- V mark centered -->
      <g transform="translate(${w/2},${h*.32})">
        <path d="M-30 -24 L0 24 L30 -24"
          stroke="#1a1a1a" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="-37" y="-30" width="6.5" height="4" rx="1" fill="#1a1a1a" opacity=".35"/>
        <rect x="-37" y="-22" width="6.5" height="4" rx="1" fill="#1a1a1a" opacity=".35"/>
        <rect x="30.5" y="-30" width="6.5" height="4" rx="1" fill="#1a1a1a" opacity=".35"/>
        <rect x="30.5" y="-22" width="6.5" height="4" rx="1" fill="#1a1a1a" opacity=".35"/>
        <circle cx="0" cy="24" r="3.2" fill="#e63030"/>
      </g>
      <!-- Wordmark -->
      <text x="${w/2}" y="${h*.64}"
        font-family="Inter,'Arial Black',sans-serif"
        font-size="${Math.floor(w*.075)}" font-weight="800"
        fill="#1a1a1a" letter-spacing="5" text-anchor="middle">VIDEOLOZY</text>
      <line x1="${w*.28}" y1="${h*.71}" x2="${w*.72}" y2="${h*.71}" stroke="#1a1a1a" stroke-width=".5" opacity=".2"/>
      <text x="${w/2}" y="${h*.83}"
        font-family="Inter,Arial,sans-serif" font-size="8.5" font-weight="500"
        fill="#1a1a1a" letter-spacing="3" text-anchor="middle" opacity=".4">POST-PRODUCTION STUDIO</text>
    </svg>`,

    /* 10 ── Showreel ───────────────────────────────────────── */
    showreel: (w, h, id) => {
      const cx = w/2, cy = h*.45;
      const r = Math.min(w,h);
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="${id}bg" cx="50%" cy="50%">
            <stop offset="0%"   stop-color="#1a0c04"/>
            <stop offset="100%" stop-color="#080502"/>
          </radialGradient>
          <radialGradient id="${id}gl" cx="50%" cy="45%">
            <stop offset="0%"   stop-color="#e65010" stop-opacity=".28"/>
            <stop offset="100%" stop-color="#e65010" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <rect width="${w}" height="${h}" fill="url(#${id}bg)"/>
        <ellipse cx="${cx}" cy="${cy}" rx="${w*.52}" ry="${h*.58}" fill="url(#${id}gl)"/>
        <circle cx="${cx}" cy="${cy}" r="${r*.22}" fill="rgba(230,80,16,.1)" stroke="rgba(230,80,16,.32)" stroke-width="1.5"/>
        <circle cx="${cx}" cy="${cy}" r="${r*.14}" fill="rgba(230,80,16,.18)"/>
        <polygon
          points="${cx+r*.07},${cy}
                  ${cx-r*.045},${cy-r*.08}
                  ${cx-r*.045},${cy+r*.08}"
          fill="rgba(255,140,60,.88)"/>
        <text x="${cx}" y="${h*.79}"
          font-family="Inter,Arial,sans-serif" font-size="13" font-weight="800"
          fill="white" letter-spacing="7" text-anchor="middle">SHOWREEL</text>
        <text x="${cx}" y="${h*.90}"
          font-family="Inter,Arial,sans-serif" font-size="9.5" font-weight="300"
          fill="rgba(255,255,255,.38)" letter-spacing="4" text-anchor="middle">2024 — 03:47</text>
        <text x="${w*.07}" y="${h*.11}"
          font-family="Inter,Arial,sans-serif" font-size="7.5" font-weight="500"
          fill="rgba(255,255,255,.22)" letter-spacing="2">VIDEOLOZY.IN</text>
      </svg>`;
    },

    /* 11 ── Creative Process ───────────────────────────────── */
    creativeProcess: (w, h, id) => {
      const steps = [
        { x: .18, n: '01', t: 'BRIEF',  c: '#60aaff' },
        { x: .50, n: '02', t: 'EDIT',   c: '#ffe600' },
        { x: .82, n: '03', t: 'GRADE',  c: '#1ee6a0' },
      ];
      const r = Math.min(w,h) * .115;
      const cy = h * .5;
      const body = steps.map(s => `
        <circle cx="${w*s.x}" cy="${cy}" r="${r}" fill="rgba(255,255,255,.03)" stroke="${s.c}" stroke-width="1.5" opacity=".7"/>
        <text x="${w*s.x}" y="${cy+4}" font-family="Inter,Arial,sans-serif" font-size="10" font-weight="800"
          fill="${s.c}" text-anchor="middle">${s.t}</text>
        <text x="${w*s.x}" y="${cy - r - 10}" font-family="Inter,Arial,sans-serif" font-size="8"
          fill="rgba(255,255,255,.28)" text-anchor="middle" letter-spacing="2">${s.n}</text>
      `).join('');
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="${id}bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"   stop-color="#08101e"/>
            <stop offset="100%" stop-color="#0a1428"/>
          </linearGradient>
        </defs>
        <rect width="${w}" height="${h}" fill="url(#${id}bg)"/>
        <line x1="${w*.18}" y1="${cy}" x2="${w*.50}" y2="${cy}" stroke="rgba(255,255,255,.07)" stroke-width="1" stroke-dasharray="4 4"/>
        <line x1="${w*.50}" y1="${cy}" x2="${w*.82}" y2="${cy}" stroke="rgba(255,255,255,.07)" stroke-width="1" stroke-dasharray="4 4"/>
        ${body}
        <text x="${w*.5}" y="${h*.12}" font-family="Inter,Arial,sans-serif" font-size="9.5" font-weight="600"
          fill="rgba(255,255,255,.28)" text-anchor="middle" letter-spacing="4">CREATIVE PROCESS</text>
        <text x="${w*.5}" y="${h*.93}" font-family="Inter,Arial,sans-serif" font-size="8"
          fill="rgba(255,255,255,.18)" text-anchor="middle" letter-spacing="2">VIDEOLOZY STUDIO</text>
      </svg>`;
    },

    /* 12 ── Film Color Palette ─────────────────────────────── */
    colorPalette: (w, h, id) => {
      const sw = ['#0a2a3c','#1a5c7a','#c8602e','#f0a850','#e8dcc8'];
      const lb = ['SHADOWS','MIDS','SKIN','HIGHS','WHITES'];
      const bw = w / 5;
      const body = sw.map((c, i) => `
        <rect x="${i*bw}" y="0" width="${bw}" height="${h*.72}" fill="${c}"/>
        <text x="${i*bw+bw/2}" y="${h*.86}" font-family="Inter,Arial,sans-serif" font-size="6.5" font-weight="700"
          fill="#1a1a1a" text-anchor="middle" letter-spacing="1" opacity=".55">${lb[i]}</text>
        <text x="${i*bw+bw/2}" y="${h*.96}" font-family="'Courier New',monospace" font-size="6"
          fill="#1a1a1a" text-anchor="middle" opacity=".35">${c.toUpperCase()}</text>
      `).join('');
      return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <rect width="${w}" height="${h}" fill="#f6f1e8"/>
        ${body}
        <text x="${w*.5}" y="${h*.67}" font-family="Inter,Arial,sans-serif" font-size="9.5" font-weight="700"
          fill="rgba(255,255,255,.58)" text-anchor="middle" letter-spacing="5">FILM PALETTE</text>
        <line x1="0" y1="${h*.72}" x2="${w}" y2="${h*.72}" stroke="rgba(0,0,0,.1)" stroke-width=".5"/>
      </svg>`;
    },

    /* 13 ── Editorial STORY ────────────────────────────────── */
    editorialStory: (w, h, id) => `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
      <rect width="${w}" height="${h}" fill="#faf7f2"/>
      <line x1="${w*.06}" y1="0" x2="${w*.06}" y2="${h}" stroke="rgba(0,0,0,.04)" stroke-width="1"/>
      <line x1="${w*.94}" y1="0" x2="${w*.94}" y2="${h}" stroke="rgba(0,0,0,.04)" stroke-width="1"/>
      <text x="${w*.06}" y="${h*.73}"
        font-family="Inter,'Arial Black',sans-serif"
        font-size="${Math.floor(w*.192)}" font-weight="900"
        fill="#111" letter-spacing="-4" opacity=".93">STORY</text>
      <rect x="${w*.06}" y="${h*.78}" width="${w*.57}" height="3" fill="#e63030"/>
      <text x="${w*.06}" y="${h*.18}"
        font-family="Inter,Arial,sans-serif" font-size="9.5" font-style="italic"
        fill="rgba(0,0,0,.28)" letter-spacing="1">We craft stories that resonate.</text>
      <text x="${w*.83}" y="${h*.18}"
        font-family="Inter,Arial,sans-serif" font-size="8.5" font-weight="700"
        fill="rgba(0,0,0,.18)" letter-spacing="2">Nº24</text>
      <text x="${w*.06}" y="${h*.94}"
        font-family="Inter,Arial,sans-serif" font-size="7.5" font-weight="600"
        fill="rgba(0,0,0,.28)" letter-spacing="3">VIDEOLOZY — NARRATIVE EDIT</text>
    </svg>`,

    /* 14 ── Atmospheric Portrait ───────────────────────────── */
    portraitAtmosphere: (w, h, id) => `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="${id}bg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#1a0e08"/>
          <stop offset="50%"  stop-color="#0c1820"/>
          <stop offset="100%" stop-color="#060a0e"/>
        </linearGradient>
        <radialGradient id="${id}fg" cx="50%" cy="40%">
          <stop offset="0%"   stop-color="#2a1808" stop-opacity=".62"/>
          <stop offset="75%"  stop-color="#0c1820" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="${w}" height="${h}" fill="url(#${id}bg)"/>
      <ellipse cx="${w*.5}" cy="${h*.36}" rx="${w*.22}" ry="${h*.32}" fill="rgba(42,24,12,.7)"/>
      <rect width="${w}" height="${h}" fill="url(#${id}fg)"/>
      <text x="${w*.5}" y="${h*.80}"
        font-family="Inter,Arial,sans-serif" font-size="14.5" font-weight="700"
        fill="rgba(255,255,255,.78)" text-anchor="middle" letter-spacing="4">BHUVAN BHASKAR</text>
      <text x="${w*.5}" y="${h*.90}"
        font-family="Inter,Arial,sans-serif" font-size="8.5" font-weight="400"
        fill="rgba(255,255,255,.32)" text-anchor="middle" letter-spacing="4">LEAD EDITOR · DIRECTOR</text>
      <text x="${w*.5}" y="${h*.10}"
        font-family="Inter,Arial,sans-serif" font-size="7.5"
        fill="rgba(255,255,255,.22)" text-anchor="middle" letter-spacing="3">VIDEOLOZY.IN</text>
    </svg>`,

    /* 15 ── Bold Color Type (far-left, partially OOB) ─────── */
    boldColorType: (w, h, id) => `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="${id}bg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%"   stop-color="#c02000"/>
          <stop offset="55%"  stop-color="#e04010"/>
          <stop offset="100%" stop-color="#801800"/>
        </linearGradient>
      </defs>
      <rect width="${w}" height="${h}" fill="url(#${id}bg)"/>
      <rect x="0" y="${h*.44}" width="${w}" height="${h*.10}" fill="rgba(0,0,0,.14)"/>
      <text x="-8" y="${h*.73}"
        font-family="Inter,'Arial Black',sans-serif"
        font-size="${Math.floor(w*.22)}" font-weight="900"
        fill="rgba(255,255,255,.90)" letter-spacing="-3">VISUAL</text>
      <text x="${w*.06}" y="${h*.92}"
        font-family="Inter,Arial,sans-serif" font-size="8" font-weight="600"
        fill="rgba(255,255,255,.38)" letter-spacing="3">VIDEOLOZY · COLOR</text>
    </svg>`,
  };

  /* ============================================================
     CARD DEFINITIONS
     cx/cy = center coordinates on the 2900×1800 canvas
     left of canvas is at -440px in viewport at rest
  ============================================================ */
  const CARDS = [
    /* Far left — partially OOB */
    { id:'c15', w:330, h:216, cx:72,   cy:490, rot:6.5,  fy:-7,  fd:7.2, fd2:1.0, op:.65, art:'boldColorType' },
    /* Left cluster */
    { id:'c1',  w:380, h:248, cx:260,  cy:390, rot:-5.5, fy:-6,  fd:7.8, fd2:0.0, op:.88, art:'typeEdit' },
    { id:'c2',  w:435, h:282, cx:310,  cy:700, rot:4.0,  fy:-10, fd:8.5, fd2:1.2, op:.82, art:'colorGrade' },
    { id:'c3',  w:365, h:238, cx:580,  cy:560, rot:-2.5, fy:-7,  fd:6.8, fd2:0.5, op:.94, art:'uiDashboard' },
    /* Center-left */
    { id:'c4',  w:450, h:290, cx:760,  cy:310, rot:5.0,  fy:-8,  fd:9.0, fd2:2.1, op:.90, art:'motionAbstract' },
    { id:'c5',  w:385, h:252, cx:800,  cy:660, rot:-3.0, fy:-5,  fd:7.5, fd2:0.8, op:.96, art:'cinemaFrame' },
    /* Center */
    { id:'c6',  w:375, h:245, cx:1060, cy:235, rot:-4.0, fy:-9,  fd:8.2, fd2:1.5, op:.85, art:'audioWave' },
    { id:'c7',  w:480, h:308, cx:1095, cy:545, rot:3.0,  fy:-6,  fd:9.4, fd2:0.2, op:1.0, art:'featuredProject' },
    { id:'c8',  w:360, h:235, cx:1080, cy:845, rot:-5.0, fy:-5,  fd:7.0, fd2:3.0, op:.78, art:'timelineUI' },
    /* Center-right */
    { id:'c9',  w:430, h:278, cx:1360, cy:345, rot:-3.5, fy:-7,  fd:8.8, fd2:0.3, op:.92, art:'brandIdentity' },
    { id:'c10', w:390, h:255, cx:1385, cy:655, rot:3.5,  fy:-8,  fd:9.2, fd2:2.5, op:.90, art:'showreel' },
    /* Right */
    { id:'c11', w:400, h:260, cx:1640, cy:262, rot:4.5,  fy:-6,  fd:7.8, fd2:1.8, op:.82, art:'creativeProcess' },
    { id:'c12', w:372, h:242, cx:1665, cy:595, rot:-2.0, fy:-7,  fd:8.0, fd2:0.6, op:.76, art:'colorPalette' },
    /* Far right */
    { id:'c13', w:420, h:272, cx:1915, cy:370, rot:-3.5, fy:-5,  fd:6.5, fd2:2.8, op:.68, art:'editorialStory' },
    { id:'c14', w:355, h:232, cx:1945, cy:710, rot:5.0,  fy:-6,  fd:7.3, fd2:3.5, op:.62, art:'portraitAtmosphere' },
  ];

  /* ============================================================
     RENDER
  ============================================================ */
  function render() {
    const canvas = document.getElementById('dsCanvas');
    if (!canvas) return;

    const dur = canvas.dataset.animDur || '22s';
    canvas.style.setProperty('--anim-dur', dur);

    canvas.innerHTML = CARDS.map(c => {
      const artFn = ART[c.art];
      if (!artFn) return '';
      const svg  = artFn(c.w, c.h, c.id);
      const left = Math.round(c.cx - c.w / 2);
      const top  = Math.round(c.cy - c.h / 2);
      return `<div class="ds-card" id="${c.id}" style="
        left:${left}px; top:${top}px;
        width:${c.w}px; height:${c.h}px;
        opacity:${c.op};
        --rot:${c.rot}deg; --fy:${c.fy}px;
        animation:ds-float ${c.fd}s ease-in-out infinite alternate ${c.fd2}s;
      ">${svg}</div>`;
    }).join('');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', render);
  } else {
    render();
  }
})();
</script>
