<!-- ============================================================
     Splash Screen / Preloader with Parallax Logo
     ============================================================ -->
<div id="splash-screen" class="fixed inset-0 z-[100] flex items-center justify-center bg-void transition-opacity duration-1000">
  <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
    <!-- Ambient glow behind logo -->
    <div class="absolute w-[30rem] h-[30rem] rounded-full opacity-20 bg-neon-yellow blur-3xl pointer-events-none animate-pulse-slow"></div>
    
    <!-- Logo wrapper for parallax -->
    <div id="splash-logo-container" class="relative z-10 p-8">
      <img 
        src="/assets/images/logo.png" 
        alt="Videolozy Logo" 
        class="w-48 h-auto drop-shadow-[0_0_20px_rgba(255,230,0,0.5)] transition-transform duration-100 ease-out"
        id="splash-logo"
      />
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const splash = document.getElementById('splash-screen');
  const splashLogo = document.getElementById('splash-logo');
  const container = document.getElementById('splash-logo-container');
  
  if (!splash || !splashLogo) return;

  // Parallax effect on mouse move
  const handleMouseMove = (e) => {
    const { clientX, clientY } = e;
    const { innerWidth, innerHeight } = window;
    
    // Calculate mouse position relative to center (-1 to 1)
    const x = (clientX / innerWidth - 0.5) * 2;
    const y = (clientY / innerHeight - 0.5) * 2;
    
    // Apply transform to logo
    const moveX = x * 30; // Max movement in px
    const moveY = y * 30;
    
    splashLogo.style.transform = `translate(${moveX}px, ${moveY}px) scale(1.05)`;
  };

  window.addEventListener('mousemove', handleMouseMove);

  // Hide splash screen after a delay
  setTimeout(() => {
    // Fade out
    splash.style.opacity = '0';
    
    // Remove from DOM after fade out completes
    setTimeout(() => {
      splash.style.display = 'none';
      window.removeEventListener('mousemove', handleMouseMove);
    }, 1000); // matches the transition-opacity duration-1000
  }, 2000); // 2 second delay before starting to fade out
});
</script>
