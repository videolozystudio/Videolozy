<!-- ============================================================
     Splash Screen / Preloader with Parallax Logo
     ============================================================ -->
<div id="splash-screen" class="fixed inset-0 z-[100] flex items-center justify-center bg-void transition-opacity duration-1000">
  <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
    <!-- Ambient glow behind logo -->
    <div class="absolute w-[30rem] h-[30rem] rounded-full opacity-20 bg-neon-yellow blur-3xl pointer-events-none animate-pulse-slow"></div>
    
    <!-- Logo wrapper for parallax -->
    <div id="splash-logo-container" class="relative z-10 p-8">
      {% videolozyLogo "splash" %}
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const splash = document.getElementById('splash-screen');
  
  if (!splash) return;

  // Hide splash screen after a delay
  setTimeout(() => {
    splash.style.opacity = '0';
    setTimeout(() => {
      splash.style.display = 'none';
    }, 1000);
  }, 2500);
});
</script>
