<!-- ============================================================
     Admin Project List Component
     Data is loaded dynamically by admin.js
     ============================================================ -->

<!-- Search + Actions Bar -->
<div class="flex flex-col sm:flex-row gap-3 mb-6">
  <div class="relative flex-1">
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted pointer-events-none"
         fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <input
      type="search"
      id="project-search"
      class="input-field pl-9"
      placeholder="Search projects…"
      autocomplete="off"
      aria-label="Search projects"
    />
  </div>

  <select id="project-category-filter" class="input-field sm:w-44">
    <option value="">All Categories</option>
    <option value="commercial">Commercial</option>
    <option value="short-film">Short Film</option>
    <option value="music-video">Music Video</option>
    <option value="documentary">Documentary</option>
  </select>

  <a href="/admin/projects/new/" class="btn-neon flex-shrink-0" id="btn-list-add">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
    </svg>
    New Project
  </a>
</div>

<!-- Table -->
<div class="glass rounded-xl border border-border overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm" id="projects-table" aria-label="Projects list">
      <thead>
        <tr class="border-b border-border">
          <th class="px-4 py-3 text-left text-2xs font-semibold text-text-muted uppercase tracking-wider w-8">
            <input type="checkbox" id="select-all" class="rounded" aria-label="Select all" />
          </th>
          <th class="px-4 py-3 text-left text-2xs font-semibold text-text-muted uppercase tracking-wider">
            Project
          </th>
          <th class="px-4 py-3 text-left text-2xs font-semibold text-text-muted uppercase tracking-wider hidden md:table-cell">
            Category
          </th>
          <th class="px-4 py-3 text-left text-2xs font-semibold text-text-muted uppercase tracking-wider hidden lg:table-cell">
            Year
          </th>
          <th class="px-4 py-3 text-left text-2xs font-semibold text-text-muted uppercase tracking-wider hidden lg:table-cell">
            Views
          </th>
          <th class="px-4 py-3 text-left text-2xs font-semibold text-text-muted uppercase tracking-wider hidden md:table-cell">
            Featured
          </th>
          <th class="px-4 py-3 text-right text-2xs font-semibold text-text-muted uppercase tracking-wider">
            Actions
          </th>
        </tr>
      </thead>
      <tbody id="projects-table-body" class="divide-y divide-border">
        <!-- Loading skeleton rows -->
        <tr class="animate-pulse">
          <td class="px-4 py-4"><div class="skeleton h-4 w-4 rounded"></div></td>
          <td class="px-4 py-4">
            <div class="flex items-center gap-3">
              <div class="skeleton h-10 w-16 rounded flex-shrink-0"></div>
              <div class="space-y-1.5">
                <div class="skeleton h-4 w-40 rounded"></div>
                <div class="skeleton h-3 w-24 rounded"></div>
              </div>
            </div>
          </td>
          <td class="px-4 py-4 hidden md:table-cell"><div class="skeleton h-4 w-20 rounded"></div></td>
          <td class="px-4 py-4 hidden lg:table-cell"><div class="skeleton h-4 w-12 rounded"></div></td>
          <td class="px-4 py-4 hidden lg:table-cell"><div class="skeleton h-4 w-16 rounded"></div></td>
          <td class="px-4 py-4 hidden md:table-cell"><div class="skeleton h-4 w-8 rounded"></div></td>
          <td class="px-4 py-4"><div class="skeleton h-4 w-16 rounded ml-auto"></div></td>
        </tr>
        <tr class="animate-pulse">
          <td class="px-4 py-4"><div class="skeleton h-4 w-4 rounded"></div></td>
          <td class="px-4 py-4">
            <div class="flex items-center gap-3">
              <div class="skeleton h-10 w-16 rounded flex-shrink-0"></div>
              <div class="space-y-1.5">
                <div class="skeleton h-4 w-32 rounded"></div>
                <div class="skeleton h-3 w-20 rounded"></div>
              </div>
            </div>
          </td>
          <td class="px-4 py-4 hidden md:table-cell"><div class="skeleton h-4 w-24 rounded"></div></td>
          <td class="px-4 py-4 hidden lg:table-cell"><div class="skeleton h-4 w-12 rounded"></div></td>
          <td class="px-4 py-4 hidden lg:table-cell"><div class="skeleton h-4 w-16 rounded"></div></td>
          <td class="px-4 py-4 hidden md:table-cell"><div class="skeleton h-4 w-8 rounded"></div></td>
          <td class="px-4 py-4"><div class="skeleton h-4 w-16 rounded ml-auto"></div></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Empty State -->
  <div id="projects-empty-state" class="hidden py-16 text-center">
    <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-card border border-border
                flex items-center justify-center">
      <svg class="w-7 h-7 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M15 10l4.553-2.069A1 1 0 0121 8.878v6.243a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
      </svg>
    </div>
    <h3 class="text-base font-semibold text-text-secondary mb-1">No projects yet</h3>
    <p class="text-sm text-text-muted mb-4">Create your first project to get started.</p>
    <a href="/admin/projects/new/" class="btn-neon text-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Add First Project
    </a>
  </div>

  <!-- Pagination Footer -->
  <div class="px-4 py-3 border-t border-border flex items-center justify-between" id="table-footer">
    <p class="text-xs text-text-muted" id="table-count">Loading…</p>
    <div class="flex items-center gap-2" id="pagination-controls">
      <button
        id="btn-prev-page"
        class="btn-ghost text-xs px-2.5 py-1.5 disabled:opacity-40 disabled:cursor-not-allowed"
        disabled
      >
        ← Prev
      </button>
      <span class="text-xs text-text-muted" id="page-indicator">1</span>
      <button
        id="btn-next-page"
        class="btn-ghost text-xs px-2.5 py-1.5 disabled:opacity-40 disabled:cursor-not-allowed"
        disabled
      >
        Next →
      </button>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div
  id="delete-confirm-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4
         bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="delete-modal-title"
>
  <div class="bg-surface border border-border rounded-xl p-6 max-w-sm w-full shadow-2xl
              transform scale-95 transition-transform duration-200" id="delete-modal-box">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-full bg-danger/15 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-danger" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
      <h2 id="delete-modal-title" class="text-base font-semibold text-white">Delete Project</h2>
    </div>
    <p class="text-sm text-text-secondary mb-6">
      Are you sure you want to delete <strong id="delete-project-name" class="text-white">this project</strong>?
      This action cannot be undone.
    </p>
    <div class="flex gap-3">
      <button id="btn-cancel-delete" class="btn-ghost flex-1 justify-center">Cancel</button>
      <button id="btn-confirm-delete" class="btn-neon bg-danger border-danger flex-1 justify-center">
        Delete
      </button>
    </div>
  </div>
</div>
