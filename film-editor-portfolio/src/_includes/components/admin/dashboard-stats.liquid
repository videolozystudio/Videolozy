{% comment %}
============================================================
Admin Dashboard Stats Component
Usage: render "components/admin/dashboard-stats"
Data is loaded dynamically by admin.js via Supabase
============================================================
{% endcomment %}

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-6" id="dashboard-stats">

  <!-- Total Projects -->
  <div class="glass rounded-xl p-5 border border-border">
    <div class="flex items-start justify-between mb-4">
      <div class="w-10 h-10 rounded-lg bg-blue-500/15 border border-blue-500/20
                  flex items-center justify-center">
        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 10l4.553-2.069A1 1 0 0121 8.878v6.243a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
      </div>
      <span class="text-2xs text-text-muted uppercase tracking-wider font-medium">All Time</span>
    </div>
    <p class="text-3xl font-bold text-white mb-1" id="stat-total-projects">
      <span class="skeleton rounded w-12 h-8 inline-block">&nbsp;</span>
    </p>
    <p class="text-sm text-text-muted">Total Projects</p>
  </div>

  <!-- Total Views -->
  <div class="glass rounded-xl p-5 border border-border">
    <div class="flex items-start justify-between mb-4">
      <div class="w-10 h-10 rounded-lg bg-neon-silver/15 border border-neon-silver/20
                  flex items-center justify-center">
        <svg class="w-5 h-5 text-neon-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
      </div>
      <span class="text-2xs text-text-muted uppercase tracking-wider font-medium">Cumulative</span>
    </div>
    <p class="text-3xl font-bold text-white mb-1" id="stat-total-views">
      <span class="skeleton rounded w-16 h-8 inline-block">&nbsp;</span>
    </p>
    <p class="text-sm text-text-muted">Total Views</p>
  </div>

  <!-- Featured Count -->
  <div class="glass rounded-xl p-5 border border-border">
    <div class="flex items-start justify-between mb-4">
      <div class="w-10 h-10 rounded-lg bg-yellow-500/15 border border-yellow-500/20
                  flex items-center justify-center">
        <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
        </svg>
      </div>
      <span class="text-2xs text-text-muted uppercase tracking-wider font-medium">Highlighted</span>
    </div>
    <p class="text-3xl font-bold text-white mb-1" id="stat-featured">
      <span class="skeleton rounded w-10 h-8 inline-block">&nbsp;</span>
    </p>
    <p class="text-sm text-text-muted">Featured Projects</p>
  </div>

  <!-- Most Viewed -->
  <div class="glass rounded-xl p-5 border border-border">
    <div class="flex items-start justify-between mb-4">
      <div class="w-10 h-10 rounded-lg bg-green-500/15 border border-green-500/20
                  flex items-center justify-center">
        <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
        </svg>
      </div>
      <span class="text-2xs text-text-muted uppercase tracking-wider font-medium">Top Performer</span>
    </div>
    <p
      class="text-base font-bold text-white mb-1 truncate leading-snug"
      id="stat-most-viewed-title"
    >
      <span class="skeleton rounded w-24 h-6 inline-block">&nbsp;</span>
    </p>
    <p class="text-sm text-text-muted">
      <span id="stat-most-viewed-count" class="text-green-400 font-semibold">—</span>
      views
    </p>
  </div>

</div>
